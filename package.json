{
  "name": "rental-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env.local -- npm run dev -w web",
    "build": "dotenv -e .env.local -- npm run build -w web",
    "start": "dotenv -e .env.local -- npm run start -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "dotenv -e .env.test -e .env.local -- vitest run",
    "test:watch": "dotenv -e .env.test -e .env.local -- vitest",
    "test:e2e": "dotenv -e .env.test -e .env.local -- playwright test",
    "db:generate": "dotenv -e .env.local -- prisma generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:seed": "dotenv -e .env.local -- node packages/db/prisma/seed.mts",
    "db:seed:demo": "dotenv -e .env.local -- tsx packages/db/prisma/demo-seed.mts",
    "db:create-owner": "dotenv -e .env.local -- node packages/db/prisma/create-owner.mts",
    "db:create-staff": "dotenv -e .env.local -- node packages/db/prisma/create-owner.mts",
    "db:seed:lease-templates": "dotenv -e .env.local -- node packages/db/prisma/seed-lease-templates.mts",
    "db:studio": "dotenv -e .env.local -- prisma studio --schema packages/db/prisma/schema.prisma",
    "db:migrate:test": "dotenv -e .env.test -e .env.local -- prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed:test": "dotenv -e .env.test -e .env.local -- node packages/db/prisma/seed.mts",
    "preflight": "if [ -x \"$HOME/.claude/bin/swapcheck\" ]; then \"$HOME/.claude/bin/swapcheck\" --quiet; fi",
    "predev": "npm run preflight",
    "predev:test": "npm run preflight",
    "pretest:e2e": "npm run preflight",
    "dev:test": "dotenv -e .env.test -e .env.local -- npm run dev -w web",
    "predev:demo": "npm run preflight",
    "dev:demo": "dotenv -e .env.demo -e .env.local -- npm run dev -w web",
    "build:test": "dotenv -e .env.test -e .env.local -- npm run build -w web",
    "start:test": "dotenv -e .env.test -e .env.local -- npm run start -w web",
    "e2e:server": "npm run build:test && npm run start:test",
    "db:migrate:all": "npm run db:migrate:test && npm run db:migrate:dev",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:status": "npm run db:status:test && npm run db:status:dev",
    "db:status:test": "dotenv -e .env.test -e .env.local -- prisma migrate status --schema packages/db/prisma/schema.prisma",
    "db:status:dev": "dotenv -e .env.local -- prisma migrate status --schema packages/db/prisma/schema.prisma",
    "db:drift": "dotenv -e .env.test -e .env.local -- prisma migrate diff --from-schema-datasource packages/db/prisma/schema.prisma --to-schema-datamodel packages/db/prisma/schema.prisma --exit-code",
    "db:reset:test": "dropdb --if-exists rental_test && createdb rental_test && npm run db:migrate:test && npm run db:seed:test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.1",
    "dotenv-cli": "^10.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.23.1",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "sharp": true,
    "unrs-resolver": true
  }
}
