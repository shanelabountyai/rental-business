{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    // Scripts run directly by Node (apps/web/scripts/*.mts) need explicit
    // extensions in their relative imports - Node's ESM resolution doesn't
    // guess them the way bundler resolution does. Safe with noEmit: true.
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    // The workspace packages are typechecked here rather than from their own
    // tsconfigs. tsc only follows the import graph, so before this line a type
    // error in packages/db - which nothing in apps/web imports yet - passed
    // `npm run typecheck` silently. R-002 puts the whole Prisma layer there.
    "../../packages/**/*.ts",
    "../../packages/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Prisma's emitted client. Generated, gitignored, and not ours to check.
    "../../packages/db/generated",
    // iCloud Drive syncs this working copy and resolves its own conflicts by
    // writing "file 2.ts" beside "file.ts". Inside .next/types that produces a
    // duplicate of every generated route type and fails `tsc`. Carried over
    // from the storage repo, where it cost an afternoon to diagnose.
    //
    // The single-character wildcard, not a literal "2": iCloud numbers each
    // successive conflict upward, and this repo hit " 3.ts" during R-005 with
    // only " 2.ts" excluded - so the gate broke on a file nobody wrote. `?`
    // covers every copy iCloud will realistically produce.
    "**/* ?.ts",
    "**/* ?.tsx",
    "**/* ?.d.ts"
  ]
}
