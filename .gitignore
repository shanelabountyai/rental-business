# dependencies
node_modules/
.pnp
.pnp.*

# secrets - never commit; .env.example documents the names
.env
.env*.local

# next.js
.next/
out/
next-env.d.ts

# prisma generated client
packages/db/generated/

# testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/
.lighthouseci/

# builds
build/
dist/
*.tsbuildinfo

# local-disk document storage (R-012) - dev/test only; a deployed instance
# points DOCUMENT_STORAGE_PATH at real durable storage instead
.data/

# vercel
.vercel

# claude code - shared settings are tracked, per-machine grants are not
.claude/settings.local.json

# os / editor
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.idea/
_to_delete/
# Appended by `vercel link`, which writes VERCEL_OIDC_TOKEN into .env.local.
# Kept, but with the exception restored: .env* on its own also swallows
# .env.example, which is tracked on purpose and documents the variable NAMES.
.env*
!.env.example
