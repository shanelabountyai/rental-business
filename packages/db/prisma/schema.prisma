// Core data model (R-002). Entity names are the canonical ones from
// docs/prds/00-master-prd.md §13 - use them here and in conversation.
//
// Invariants this file encodes, from docs/prds/07-decisions.md:
//   D-3  Money is integer cents, always a suffix-`Cents` Int. No floats, no
//        Decimal, anywhere in money. Percentages are basis points (`Bps`), so
//        a "5% late fee" is 500 and stays exact. Timestamps are UTC; fields
//        that mean a property-local calendar day are `@db.Date`, never a
//        DateTime, because "the 3rd" in Houston is not an instant.
//   D-4  Jurisdiction rules are versioned, effective-dated ROWS. No statutory
//        number appears as a default, a constant, or an enum in this file.
//   D-5  No superuser flag. StaffUser carries no permission bits at all;
//        R-004 adds roles-as-data and the assignment table that scopes them.
//   D-9  ONE Task table serves every staff queue. Do not add a second.
//   D-11 LedgerEntry is an append-only PROJECTION of Stripe, not the origin
//        of charges. Enforced by a trigger in the migration, not by manners.
//   D-12 Statutory amounts are computed in core and stored with the
//        JurisdictionRule version that produced them, so a charge raised in
//        2026 can still be explained in a 2029 courtroom.
//
// Scoping: every operational and financial row carries `propertyId` directly,
// per §13. It is denormalized on purpose - R-004 scopes every query by
// property and legal entity, and a scope check that has to join three tables
// to find out who owns a row is a scope check that gets skipped.
//
// Never stored anywhere in this schema: SSNs, taxpayer IDs, card numbers,
// bank account numbers. Screening is provider-hosted (D-7) and payment
// instruments are Stripe-hosted (D-11). LegalEntity deliberately has no EIN
// field - a single-member LLC often uses the owner's SSN as its TIN, and the
// safest place for that is nowhere.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
//
// An enum here means "a closed set the code branches on". Anything a statute
// could change is a JurisdictionRule column instead (D-4). LateFeeType is an
// enum because it names a formula shape; the rate, cap and grace days that
// feed the formula are rule columns.
// ---------------------------------------------------------------------------

enum LegalEntityType {
  LLC
  PERSONAL
  TRUST
  CORPORATION
  PARTNERSHIP
}

enum PropertyType {
  SINGLE_FAMILY
  DUPLEX
  TRIPLEX
  FOURPLEX
  TOWNHOUSE
  CONDO
  MANUFACTURED
}

enum UnitStatus {
  OCCUPIED
  VACANT
  MAKE_READY
  DOWN
}

/// R-056 (LEASE-01). DRAFT is edited but never public. PUBLISHED is the
/// hosted page anyone can reach. UNPUBLISHED is a listing that WAS public
/// and no longer is - kept, not deleted, so re-listing the same unit later
/// is a new row rather than resurrecting one that has since gone stale, and
/// so R-057's "delist within 24h of lease-up" has a real state to move to
/// rather than only DRAFT/PUBLISHED to choose between.
enum ListingStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

/// The lease lifecycle (LEASE-06, R-033).
///
/// NOTE WHAT IS ABSENT: there is no NOTICE_GIVEN state. A tenancy under
/// notice is still a live tenancy - rent is still due, repairs are still
/// owed, entry notice still applies - and modelling it as a separate status
/// would mean every "is this lease in force?" check in the product had to
/// remember to include it. Notice is a FACT about an active lease
/// (`Lease.noticeGivenAt`), not a state of it. The backlog's
/// "pending / active / notice-given / ended" describes what a PM sees on
/// screen, which is exactly how it is rendered.
enum LeaseStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  MONTH_TO_MONTH
  /// Ran its course: the term expired or the tenant moved out as agreed.
  ENDED
  /// Cut short - eviction, early termination, mutual release. The reason is
  /// required (`terminationReason`), because "ended" and "we had to end it"
  /// are different facts to anybody reading the record later.
  TERMINATED
}

/// Who gave notice to end a tenancy (R-033).
enum NoticeParty {
  TENANT
  LANDLORD
}

/// Where a tenancy came from (RISK-08, R-033).
enum LeaseOrigin {
  /// The ordinary path: an inquiry, an application, screening, a signature.
  APPLICATION
  /// Inherited with the building at acquisition. There is no application and
  /// there never will be one - the paperwork that exists is whatever the
  /// seller handed over, which is frequently a photocopy and sometimes
  /// nothing. Every gap this creates is tracked rather than papered over.
  INHERITED
}

/// Whether the security deposit money actually reached us (RISK-08).
///
/// The distinction is not bookkeeping trivia. In most states the CURRENT
/// owner owes the deposit back at move-out regardless of whether the seller
/// ever handed it over - so a tenancy where this is UNKNOWN is an
/// unquantified liability sitting on the balance sheet, and the only moment
/// it is cheap to establish is at acquisition while the seller is still
/// answering the phone.
enum DepositTransferStatus {
  /// We collected it ourselves. The ordinary case.
  NOT_APPLICABLE
  /// Inherited and not yet established. The state that costs money.
  UNKNOWN
  /// The seller handed it over - as cash, or as a credit at closing. Both
  /// mean the same thing for the question that matters: we hold it.
  TRANSFERRED
  /// The seller kept it. We are very likely still liable for it, so this is
  /// recorded rather than treated as "no deposit".
  NOT_TRANSFERRED
}

/// Who owes a portion of a lease's rent. A voucher lease has a
/// HOUSING_AUTHORITY payer alongside the TENANT payer; an ordinary lease has
/// exactly one TENANT payer carrying the whole charge. See PayerAllocation.
enum PayerType {
  TENANT
  HOUSING_AUTHORITY
  GUARANTOR
  OTHER
}

enum ChargeType {
  RENT
  LATE_FEE
  NSF_FEE
  UTILITY
  RUBS_ALLOCATION
  PET_RENT
  PET_FEE
  DEPOSIT
  CHARGEBACK
  CONCESSION
  LEGAL_COST
  OTHER
}

enum PaymentChannel {
  ACH
  CARD
  RETAIL_CASH
  OFFLINE_CHECK
  MONEY_ORDER
  OFFLINE_CASH
  HAP_ACH
  OTHER
}

/// Stripe's own collection-method values, spelled exactly as Stripe spells
/// them (D-29). Lowercase rather than this schema's usual SCREAMING_CASE on
/// purpose: these strings go straight onto the Stripe API and come straight
/// back off it, and a mapping layer between two spellings of the same closed
/// set is a translation nobody needs and one more place to drift.
enum CollectionMethod {
  charge_automatically
  send_invoice
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
  REVERSED
  REFUNDED
}

/// Amounts are signed: CHARGE is positive (increases what is owed), PAYMENT
/// and CREDIT are negative. A REVERSAL carries the opposite sign of the entry
/// it reverses and points at it via `reversesId` - corrections are never
/// edits or deletes (D-11).
enum LedgerEntryType {
  CHARGE
  PAYMENT
  CREDIT
  REVERSAL
  ADJUSTMENT
}

enum DepositType {
  SECURITY
  PET
  LAST_MONTH
  SURETY_BOND
}

enum TicketSource {
  PORTAL
  SMS
  EMAIL
  PHONE_LOGGED
  STAFF
}

enum TicketStatus {
  NEW
  TRIAGED
  WAITING_ON_TENANT
  CONVERTED
  MERGED
  CLOSED
}

enum Priority {
  EMERGENCY
  URGENT
  ROUTINE
}

enum WorkOrderStatus {
  SUBMITTED
  TRIAGED
  PENDING_APPROVAL
  APPROVED
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  WORK_COMPLETE
  VERIFIED
  INVOICED
  CLOSED
  ON_HOLD_WARRANTY
  WAITING_ON_TENANT
  CANCELED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum InspectionType {
  MOVE_IN
  MOVE_OUT
  PRE_MOVE_OUT
  PERIODIC
  SEASONAL
  DRIVE_BY
}

enum ItemCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
  MISSING
}

enum MessageChannel {
  PORTAL
  SMS
  EMAIL
  CALL_LOG
}

/// TCPA consent (R-051b, COMM-02). VOICE is listed because the statute
/// governs calls as well as texts; nothing places calls today, and the send
/// path gates SMS only.
enum ConsentChannel {
  SMS
  EMAIL
  VOICE
}

/// HOW consent was obtained - the point of the record. "Consented" alone is
/// unfalsifiable six months later; what defends a claim is the basis.
/// Only EXPRESS_WRITTEN covers promotional sending.
enum ConsentBasis {
  EXPRESS_WRITTEN
  EXISTING_RELATIONSHIP
  VERBAL
  IMPORTED
}

enum ConsentSource {
  STAFF_RECORDED
  PORTAL
  BACKFILL
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  BOUNCED
  /// R-016: decided, recorded, and deliberately not sent - preference off,
  /// kill switch, or no address on file. A suppressed notification is still
  /// a row, because "why didn't the tenant get the late notice?" is a real
  /// support question and an absent record cannot answer it.
  SUPPRESSED
  /// R-016: held for quiet hours (NOTIF-05) and due to go out later. The
  /// drain job moves these to SENT once `sendAfter` passes.
  DEFERRED
}

/// Who a notification is addressed to (R-016). A discriminator rather than
/// four nullable foreign keys: see Notification's own comment for why the
/// engine stores the recipient as (type, id) plus the address as actually
/// sent.
enum NotificationRecipientType {
  STAFF
  TENANT
  GUARANTOR
  VENDOR
  /// R-058. Has no account and never will for this message - a prospect
  /// answering pre-screening questions is not yet a Tenant. Never reaches
  /// PORTAL (packages/core/notifications categoryChannels restricts
  /// `prospect_prescreening` to EMAIL/SMS): "the notification IS the
  /// delivery, read in the portal" (Notification's own comment on PORTAL)
  /// has no portal for this recipient to read it in.
  PROSPECT
  /// R-059. One adult in a household application - a SEPARATE recipient
  /// type from PROSPECT even for the lead applicant (who is also a
  /// Prospect), because an invite is addressed to the person filling in
  /// THIS form at THIS link, not to the household's original inquiry.
  APPLICANT
}

/// How a legally significant notice was served. Which of these are valid for
/// a given notice type is jurisdiction config (D-4), not a property of this
/// enum - these are only the mechanics the product can record proof for.
enum NoticeServiceMethod {
  PERSONAL
  POSTED_WITH_PHOTO
  CERTIFIED_MAIL
  FIRST_CLASS_MAIL
  EMAIL
  PORTAL
  PROCESS_SERVER
}

enum LateFeeType {
  NONE
  FLAT
  PERCENT_OF_RENT
  DAILY
  FLAT_PLUS_DAILY
}

enum ActorType {
  STAFF
  TENANT
  VENDOR
  SYSTEM
}

// ---------------------------------------------------------------------------
// Ownership & inventory
// ---------------------------------------------------------------------------

model LegalEntity {
  id                      String          @id @default(cuid())
  name                    String
  type                    LegalEntityType
  formationState          String? // two-letter, e.g. "TX"
  registeredAgent         String?
  notes                   String?
  active                  Boolean         @default(true)
  /// MAINT-04's "my configured cost threshold": a work order estimated above
  /// this needs an explicit approval before it can be dispatched. Set on the
  /// ENTITY rather than the property or a global singleton because the LLC is
  /// this product's ownership boundary (Entity -> Property -> Unit) - an owner
  /// with a partner in one LLC and none in another genuinely wants different
  /// numbers. Null falls back to APPROVAL_DEFAULTS in packages/core/approvals.
  approvalThresholdCents  Int?
  /// How far actuals may exceed what was approved before it has to go back
  /// (MAINT-04's "e.g. 10%"). Whole percent.
  actualsTolerancePercent Int?
  /// Above this, collect competing bids rather than dispatching one vendor.
  bidThresholdCents       Int?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  properties  Property[]
  assignments StaffAssignment[]

  @@index([active])
}

model Property {
  id             String       @id @default(cuid())
  legalEntityId  String
  name           String
  addressLine1   String
  addressLine2   String?
  city           String
  /// Two-letter state code. Drives EVERY jurisdiction lookup (D-4) - a
  /// property with the wrong state silently gets another state's grace
  /// period, deposit deadline and notice periods.
  state          String
  postalCode     String
  county         String?
  /// Freeform, staff-set label - "Dallas-Fort Worth" - not derived from
  /// `city`/`state` (R-053, COMM-04). A real metro spans city boundaries a
  /// straight city match cannot group, and there is no canonical geography
  /// table here: two properties disagreeing on spelling just fail to group
  /// on the segment picker, which is visible and correctable, unlike a wrong
  /// automatic grouping would be.
  metro          String?
  /// Freeform staff labels for ad-hoc grouping - "downtown", "flood-zone" -
  /// used today only to target segment announcements (R-053, COMM-04).
  tags           String[]     @default([])
  country        String       @default("US")
  latitude       Decimal?     @db.Decimal(9, 6)
  longitude      Decimal?     @db.Decimal(9, 6)
  /// IANA zone, e.g. "America/Chicago". Every nightly job runs in this zone,
  /// not UTC (D-3). Not nullable: a property without one cannot be billed.
  timezone       String
  propertyType   PropertyType
  bedrooms       Int?
  bathrooms      Decimal?     @db.Decimal(3, 1)
  yearBuilt      Int?
  acquiredOn     DateTime?    @db.Date
  /// From the deed/closing disclosure (PROP-06). A single fact, not its own
  /// model, unlike Mortgage/InsurancePolicy/Warranty below - there is only
  /// ever one basis, not a repeating or versioned record.
  costBasisCents Int?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  legalEntity       LegalEntity       @relation(fields: [legalEntityId], references: [id])
  units             Unit[]
  leases            Lease[]
  leasePayers       LeasePayer[]
  charges           Charge[]
  payments          Payment[]
  ledgerEntries     LedgerEntry[]
  deposits          Deposit[]
  recurringCharges  RecurringCharge[]
  utilityBills      UtilityBill[]
  tickets           Ticket[]
  workOrders        WorkOrder[]
  inspections       Inspection[]
  threads           Thread[]
  notices           Notice[]
  tasks             Task[]
  documents         Document[]
  listings          Listing[]
  prospects         Prospect[]
  applications      Application[]
  auditLogs         AuditLog[]
  assignments       StaffAssignment[]
  outboxEvents      OutboxEvent[]
  jobRuns           JobRun[]
  mortgages         Mortgage[]
  insurancePolicies InsurancePolicy[]
  hoaInfo           HoaInfo?
  warranties        Warranty[]
  notifications     Notification[]

  @@index([legalEntityId])
  @@index([state])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Property filing cabinet (PROP-06, R-015)
//
// Every "alert" PROP-06 asks for (ARM adjustment, balloon maturity, insurance
// renewal) is computed by a query, never stored as a boolean or fired by a
// job here - R-016 (notification engine) and R-077 (compliance calendar,
// PROP-05) do not exist yet, so there is nothing to deliver an alert
// through. This is the same "report, not automated action" shape R-012's
// retention rules and R-014's reveal mechanism both already used for a
// consumer that does not exist yet.
//
// Supporting documents (the deed itself, the mortgage note, the declarations
// page, HOA CC&Rs, warranty contracts) attach through the existing Document
// model (propertyId + a new `type`) - the same choice R-014 made for shutoff
// photos, not a dedicated FK per record here, since a property typically has
// one active mortgage and one active policy at a time and the document list
// is filterable by type regardless.
// ---------------------------------------------------------------------------

model Mortgage {
  id                  String    @id @default(cuid())
  propertyId          String
  lender              String
  originalAmountCents Int?
  currentBalanceCents Int?
  /// FIXED or ARM.
  rateType            String
  interestRateBps     Int?
  /// Set only when rateType = ARM.
  armAdjustmentDate   DateTime? @db.Date
  maturityDate        DateTime? @db.Date
  isBalloon           Boolean   @default(false)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model InsurancePolicy {
  id              String   @id @default(cuid())
  propertyId      String
  carrier         String
  policyNumber    String?
  limitsCents     Int?
  deductibleCents Int?
  lossOfRents     Boolean  @default(false)
  /// Next renewal date - the field the 45-60 day shopping-window alert
  /// reads (PROP-06).
  renewsOn        DateTime @db.Date
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, renewsOn])
}

/// One row per property, unlike Mortgage/InsurancePolicy/Warranty - a
/// property belongs to at most one HOA.
model HoaInfo {
  id              String   @id @default(cuid())
  propertyId      String   @unique
  name            String?
  contactInfo     String?
  hasRentalCap    Boolean  @default(false)
  /// Free text - "capped at 20% of units, waitlist as of 2024" is not
  /// something a boolean or a single number represents honestly.
  rentalCapPolicy String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
}

model Warranty {
  id              String    @id @default(cuid())
  propertyId      String
  /// ROOF, HVAC, WATER_HEATER, APPLIANCE, HOME_WARRANTY, OTHER.
  category        String
  provider        String
  coverageSummary String?
  /// Null means no expiration on file, not "never expires" - treated as
  /// "unknown", the safe direction for a coverage-before-dispatch check.
  expiresOn       DateTime? @db.Date
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model Unit {
  id              String     @id @default(cuid())
  propertyId      String
  /// "Main house", "ADU", "Unit A". Unique per property.
  name            String
  status          UnitStatus @default(VACANT)
  marketRentCents Int?
  bedrooms        Int?
  bathrooms       Decimal?   @db.Decimal(3, 1)
  squareFeet      Int?
  notes           String?
  /// Cosmetic, not operational in the safety sense (PROP-03) - kept as a
  /// plain field on Unit rather than its own model, unlike the versioned/
  /// structured data below, because it needs neither history nor structure.
  paintColor      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  property        Property          @relation(fields: [propertyId], references: [id])
  leases          Lease[]
  tickets         Ticket[]
  workOrders      WorkOrder[]
  inspections     Inspection[]
  documents       Document[]
  accessCodes     AccessCode[]
  appliances      Appliance[]
  utilityAccounts UtilityAccount[]
  shutoffs        ShutoffLocation[]
  listings        Listing[]

  @@unique([propertyId, name])
  @@index([status])
}

/// A listing for one unit (LEASE-01, R-056). Photos are NOT copied here -
/// they are read live from the unit's own photo library (`Document`, type
/// `UNIT_PHOTO`), so a photo added or retired on the unit record is
/// reflected on a live PUBLISHED listing without anybody re-uploading
/// anything. Disclosure text (deposit cap, fee cap, source-of-income
/// protection) is likewise never stored - it is composed at read time from
/// the property's CURRENT `JurisdictionRule` (packages/core/listings), the
/// same "never a stored guess" posture every other jurisdiction-derived
/// number in this product already takes (D-4): a listing is a live page,
/// not a signed document, and should say what the law requires TODAY.
///
/// Ordinary mutable record, not append-only - a listing is edited and
/// republished the way a lease or a property is, not evidence of a single
/// past event the way a Message or a Notice is.
model Listing {
  id                  String        @id @default(cuid())
  propertyId          String
  unitId              String
  status              ListingStatus @default(DRAFT)
  headline            String?
  description         String?
  rentCents           Int
  /// The ASKING deposit stated in the listing - independent of `Deposit`,
  /// which is the per-lease liability record that exists only once a
  /// tenancy is signed. Null means "not stated", not zero.
  depositCents        Int?
  /// The ASKING application fee (R-059) - independent of
  /// `JurisdictionRule.applicationFeeCapCents`, the statutory ceiling.
  /// Null means "no fee configured", not zero; charging clamps whatever is
  /// set here to the cap at charge time (D-4, D-12), never the reverse.
  applicationFeeCents Int?
  /// Property-local calendar day (D-3), matching Lease.startsOn's own
  /// @db.Date - a move-in date has no time of day.
  availableOn         DateTime      @db.Date
  requirements        String?
  petsAllowed         Boolean       @default(false)
  petPolicyText       String?
  publishedAt         DateTime?
  createdByStaffId    String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  property     Property             @relation(fields: [propertyId], references: [id])
  unit         Unit                 @relation(fields: [unitId], references: [id])
  createdBy    StaffUser?           @relation("ListingCreatedBy", fields: [createdByStaffId], references: [id])
  syndications ListingSyndication[]
  leads        ListingLead[]
  prospects    Prospect[]
  applications Application[]

  @@index([propertyId, status])
  @@index([unitId, status])
}

/// LISTED means the simulated network currently carries it. FAILED is
/// terminal for that attempt, not for the listing - a retry issues a fresh
/// `list()` call and moves the same row back to LISTED.
enum SyndicationStatus {
  LISTED
  DELISTED
  FAILED
}

/// One row per (listing, network) - R-057 (LEASE-02, D-7).
///
/// `externalId` and `lastFaultCode` are what makes this D-27-compliant: they
/// record what the simulated network actually TOLD us, not a mirror of our
/// own `Listing.status`. If this table only ever restated our own state, "is
/// it live on the network" and "did we mean to publish it" would agree by
/// construction, and the ≤24h-delist path R-057 exists to prove would have
/// nothing independent to check against - the same defect D-27 found and
/// fixed in the Stripe simulator.
model ListingSyndication {
  id            String            @id @default(cuid())
  listingId     String
  /// Closed vocabulary in packages/core/listings (SYNDICATION_NETWORKS) -
  /// a plain string, not a DB enum, so a real driver adding a network later
  /// (D-7: Phase 3, partner-gated) is a one-line code change, not a
  /// migration - the same call Document.type already makes for the same
  /// reason.
  network       String
  status        SyndicationStatus
  /// The id the simulated network assigned when it accepted the listing.
  /// Null until a successful `list()` call.
  externalId    String?
  /// Set only when the last attempt faulted (D-7's "fault injection... so
  /// the error paths are exercised in CI"). Cleared on the next success.
  lastFaultCode String?
  listedAt      DateTime?
  delistedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([listingId, network])
  @@index([listingId])
}

/// An inbound visit to the public listing page carrying a tracked source
/// (LEASE-02: "inbound leads carry source attribution"). Deliberately bare -
/// no name, email or message field - because there is no intake to attach
/// one to yet; R-058's prospect pipeline is what turns a visit into a real
/// lead record with a person behind it. This is the minimum this item can
/// build honestly: proof of WHICH network sent someone, for R-058 to build
/// on, the same "shared thing before its second consumer" call D-9 already
/// made for the one Task queue.
model ListingLead {
  id         String   @id @default(cuid())
  listingId  String
  /// A network name from SYNDICATION_NETWORKS, or "direct" for a visit with
  /// no `?src=` at all - recorded rather than skipped, so "how many visits
  /// had no attributable source" is answerable instead of invisible.
  source     String
  occurredAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id])

  @@index([listingId, occurredAt])
}

/// The household applying for one listing (LEASE-03, R-059) - the group the
/// PRD means by "co-applicants get their own links and the applications
/// group". Deliberately a THIN group record: every real answer (name, DOB,
/// income, the fee) lives on `Applicant`, one row per adult, so a household
/// of three is three independent, individually-linked people rather than
/// one record wearing three hats. Always descends from a `Prospect` -
/// staff invite the prospect who inquired (or was shown the unit) to apply,
/// which is what creates this row and its first (lead) `Applicant` -
/// there is no route to an Application with no Prospect behind it.
///
/// `completedAt` is the "completion timestamp (which drives
/// order-of-processing)" the backlog names for R-060 to build on - set only
/// once EVERY `Applicant` under this group has its own `completedAt`, i.e.
/// the whole household is done, not just whoever applied first.
model Application {
  id          String    @id @default(cuid())
  propertyId  String
  listingId   String
  prospectId  String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property   Property    @relation(fields: [propertyId], references: [id])
  listing    Listing     @relation(fields: [listingId], references: [id])
  prospect   Prospect    @relation(fields: [prospectId], references: [id])
  applicants Applicant[]

  @@index([propertyId])
  @@index([listingId])
  @@index([prospectId])
}

/// One adult (LEASE-03: "one per adult 18+"). `isLead` marks the person
/// staff actually invited (the prospect); everyone else was added BY the
/// lead through `inviteCoApplicant` and got their own `APPLICATION_LINK`
/// token, subject-typed to their own `Applicant.id` - never to the
/// `Application` as a whole, which is the entire mechanism behind "their
/// own links" in the PRD text.
///
/// Residence/income capture is deliberately ONE current address and ONE
/// employer, not a repeatable history list - the PRD says "residence
/// history" but a multi-entry timeline is a bigger form than an MVP
/// warrants; this is the minimum that lets R-060's screening actually ask
/// "where do you live and what do you earn".
///
/// `feeCents` is snapshotted from `Listing.applicationFeeCents` (clamped to
/// `JurisdictionRule.applicationFeeCapCents`) at invite time, not read live
/// at payment time - a fee that changes after someone was invited must not
/// change what they owe mid-application, the same reasoning
/// `Deposit.depositCents` already gives for freezing a lease's own number
/// at signing rather than tracking the listing forever.
model Applicant {
  id            String    @id @default(cuid())
  applicationId String
  isLead        Boolean   @default(false)
  firstName     String
  lastName      String
  email         String?
  phone         String?
  dateOfBirth   DateTime? @db.Date

  currentAddressLine1    String?
  currentCity            String?
  currentState           String?
  currentPostalCode      String?
  monthsAtCurrentAddress Int?
  employerName           String?
  monthlyIncomeCents     Int?

  feeCents              Int?
  stripeCustomerId      String?
  stripePaymentIntentId String?
  feePaidAt             DateTime?

  /// The form itself validated clean and was submitted - set synchronously
  /// by the submit action. Separate from `completedAt` because a fee clears
  /// asynchronously, on Stripe's own timeline (the webhook, D-11): an
  /// applicant can submit a fully valid form and then wait seconds or
  /// minutes for `feePaidAt` to catch up, and this is what lets the page
  /// tell "still filling it in" apart from "submitted, just waiting on
  /// payment" instead of collapsing both into the same null.
  formSubmittedAt DateTime?
  /// `formSubmittedAt` is set AND the fee cleared (or none was due) - set
  /// by the fee webhook once both are true, since the webhook is always the
  /// LAST of the two to happen when a fee is owed. Null the whole time
  /// either half is outstanding - "progress is saved" (the PRD's
  /// save-and-resume line) means every write before this happens, not just
  /// the last one.
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application     Application      @relation(fields: [applicationId], references: [id])
  documents       Document[]
  screeningReport ScreeningReport?
  /// FCRA adverse-action notices (R-061) - the "either" half of Notice's
  /// either/or, the "or" being `leaseId`.
  notices         Notice[]

  @@index([applicationId])
  @@index([stripeCustomerId])
}

/// Written screening criteria (LEASE-04, R-060; D-7), versioned like
/// AccessCode/JurisdictionRule (D-4's pattern reused): never edited in
/// place, a new version supersedes the old one so a past decision stays
/// explainable against the criteria actually in force when it was made.
///
/// NOT scoped like JurisdictionRule (state/jurisdiction) - D-4 scopes that
/// table to statute, each field carrying a citation. Screening criteria are
/// owner policy, not law, and the fair-housing defense this table exists
/// for depends on the SAME criteria applying to every applicant across the
/// whole portfolio, not a jurisdiction-by-jurisdiction patchwork.
///
/// `reviewedBy` is null until an owner records who actually reviewed a
/// version - the seeded v1 row is a placeholder drafted with no attorney
/// review (07-decisions.md OQ-6 was answered "draft defaults now" rather
/// than "criteria already exist"), the same honestly-flagged posture
/// JurisdictionRule's own seed comment already uses for the identical gap.
model ScreeningCriteria {
  id      String @id @default(cuid())
  version Int

  /// Minimum monthly income as a multiple of rent, x100 (300 = 3.00x) -
  /// integer, same reasoning money-as-cents gives everywhere else: a float
  /// multiplier invites rounding drift into a number a decline gets
  /// defended against.
  incomeToRentMultiplierX100 Int
  /// Null = no floor applied. Compared only against the provider's own
  /// reported score (ScreeningReport.creditScore) - never against anything
  /// derived from Applicant's own fields (D-27).
  minCreditScore             Int?
  evictionLookbackMonths     Int
  /// A record found inside this window is flagged for staff to read, never
  /// an automatic decline - HUD's 2016 guidance on criminal-history
  /// screening is why "individualized-assessment notes" exists on
  /// ScreeningReport at all: nature, severity and time elapsed have to be
  /// weighed by a person, not a threshold.
  criminalLookbackMonths     Int

  citation   String?
  reviewedBy String?
  notes      String?

  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  createdByStaffId String?
  createdAt        DateTime  @default(now())

  createdBy StaffUser? @relation(fields: [createdByStaffId], references: [id])

  @@unique([version])
  @@index([effectiveTo])
}

/// One consumer report per Applicant (LEASE-04, R-060) - screening is
/// individual, not per household: FCRA consent and the report itself
/// belong to one person, the same granularity R-059 already gave income,
/// documents and the fee.
///
/// PROVIDER-HOSTED, NO SSN: nothing upstream of `ScreeningAdapter.order()`
/// carries anything SSN-shaped (see this file's header) - the adapter is
/// handed an applicant id and returns a provider reference and report
/// facts, exactly what a real hosted-flow integration would hand back over
/// its own webhook.
///
/// THE REPORT FACTS ARE NEVER DERIVED FROM ANYTHING THE DECISION READS
/// (D-27). `SimulatedScreeningAdapter` generates them from a hash of the
/// applicant id, not from `Applicant.monthlyIncomeCents` or any other
/// field the criteria comparison also reads - otherwise the simulator
/// would agree with the criteria evaluator by construction and "results
/// displayed alongside criteria" would prove nothing.
///
/// `criteriaVersion` is pinned at order time, the same snapshot reasoning
/// `Applicant.feeCents` already gives the application fee: a criteria
/// version bump after ordering must not silently move what this applicant
/// is judged against.
///
/// NO ALGORITHMIC SCORE COLUMN EXISTS HERE, EVER (LEASE-04's own words).
/// `decision` is written by a staff member alone - see
/// apps/web/lib/screening/staff-actions.ts.
model ScreeningReport {
  id          String  @id @default(cuid())
  applicantId String  @unique
  providerId  String
  /// ORDERED, COMPLETE, FAILED.
  status      String
  faultCode   String?

  creditScore         Int?
  evictionRecordFound Boolean?
  criminalRecordFound Boolean?

  criteriaVersion Int

  /// APPROVED, APPROVED_WITH_CONDITIONS, DECLINED. Null until a staff
  /// member decides - "accept/decline always an explicit human action"
  /// (LEASE-04).
  decision         String?
  /// The individualized-assessment note LEASE-04 asks to retain - required
  /// for anything but a plain APPROVED (apps/web/lib/screening's own
  /// validation), because a decline or a conditional approval is exactly
  /// the case HUD's guidance says needs a person's stated reasoning, not a
  /// threshold.
  decisionNotes    String?
  decidedAt        DateTime?
  decidedByStaffId String?

  /// The reporting agency's own identity, as the (simulated) adapter
  /// returned it at order time - rendered, multi-line text, not structured
  /// columns, since nothing here ever queries by agency name or address;
  /// it exists only to be reproduced verbatim in the FCRA adverse-action
  /// notice (R-061), which is required to name the CRA that supplied the
  /// report. Frozen at order time for the same reason `criteriaVersion` is:
  /// a real adapter swap later must not rewrite what an already-screened
  /// applicant was told.
  agencyContact String?

  /// The FCRA adverse-action notice generated the moment `decision` is
  /// written as anything but a plain APPROVED (R-061) - null for an
  /// APPROVED decision, since none is owed. Set inside the same
  /// transaction that writes `decision`.
  adverseActionNoticeId            String?   @unique
  /// The compliance block's escape hatch: "blocks closing the application
  /// until sent or overridden with a logged reason" (LEASE-05). Null until
  /// a staff member explicitly overrides the block - see
  /// 'adverse_action.overridden' in packages/core/audit/events.ts, which is
  /// REASON_REQUIRED, the same enforcement `entry_notice.overridden`
  /// already gives its own override.
  adverseActionOverrideReason      String?
  adverseActionOverriddenAt        DateTime?
  adverseActionOverriddenByStaffId String?

  orderedAt   DateTime  @default(now())
  completedAt DateTime?

  applicant                 Applicant  @relation(fields: [applicantId], references: [id])
  decidedBy                 StaffUser? @relation("ScreeningReportDecidedBy", fields: [decidedByStaffId], references: [id])
  adverseActionNotice       Notice?    @relation(fields: [adverseActionNoticeId], references: [id])
  adverseActionOverriddenBy StaffUser? @relation("ScreeningReportAdverseActionOverriddenBy", fields: [adverseActionOverriddenByStaffId], references: [id])

  @@index([applicantId])
}

/// inquiry -> pre-screened -> showing -> applied -> screened -> approved ->
/// signed (LEASE-07's own phrasing). Only the first two transitions are
/// automated by anything built so far - the rest are set by a staff member
/// tracking real-world progress a link-hover-away future item will
/// eventually drive (showing scheduling is LEASE-08, application is
/// LEASE-03, screening is LEASE-04, e-sign is LEASE-06) - the same "ship
/// the state before its automated consumer exists" call R-056/057 already
/// made for ListingStatus.UNPUBLISHED.
enum ProspectStatus {
  INQUIRY
  PRE_SCREENED
  SHOWING
  APPLIED
  SCREENED
  APPROVED
  SIGNED
}

/// A named person behind an inquiry (LEASE-07, R-058) - the record
/// `ListingLead` was deliberately built without one (see that model's own
/// comment). Created only when real contact information is actually
/// submitted through the public inquiry form, never from a bare page visit.
model Prospect {
  id         String         @id @default(cuid())
  propertyId String
  listingId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  /// Free text from the inquiry form itself - never a substitute for the
  /// five fixed pre-screening fields below, which stay their own columns so
  /// every prospect answers the identical structured question (the whole
  /// fair-housing point of this item).
  message    String?
  /// A network name from SYNDICATION_NETWORKS, or "direct" - same meaning
  /// as ListingLead.source, carried onto the named record once one exists.
  source     String
  status     ProspectStatus @default(INQUIRY)

  // The five fixed pre-screening answers (LEASE-07's own list). All null
  // until preScreenRespondedAt is set - a prospect who has not yet answered
  // has partial data, never zeros or empty strings standing in for "unknown".
  moveDate             DateTime? @db.Date
  occupants            Int?
  petsDescription      String?
  /// Closed vocabulary in packages/core/prospects (INCOME_RANGES) - a
  /// plain string, not a DB enum, matching Notification.category's own
  /// reasoning: a bracket added later is a one-line code change, not a
  /// migration.
  incomeRange          String?
  priorEvictions       Boolean?
  priorEvictionsDetail String?

  preScreenSentAt      DateTime?
  preScreenRespondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id])
  listing      Listing       @relation(fields: [listingId], references: [id])
  applications Application[]

  @@index([propertyId, status])
  @@index([listingId])
}

// ---------------------------------------------------------------------------
// Unit operational data (PROP-03, R-014)
// ---------------------------------------------------------------------------

/// A door/gate/lockbox code, versioned like JurisdictionRule (D-4's pattern
/// reused): never edited in place, a new code supersedes the old one, and
/// the "history log" PROP-03 asks for is just every row that ever existed
/// for this (unitId, type) slot. `sealedCode` is ciphertext -
/// packages/core/auth/secret-box.ts's sealSecret()/openSecret(), the same
/// AES-256-GCM primitive R-003 built for the MFA seed - a code has to be
/// read back, so it is encrypted, never hashed.
///
/// One current code per (unitId, type): a unit with two physical lockboxes
/// needs a second `type` value (or OTHER with a distinguishing `label`) -
/// this does not model multiple simultaneous codes of the same type. Real
/// gap, not solved generically here.
model AccessCode {
  id               String    @id @default(cuid())
  unitId           String
  /// LOCKBOX, SMART_LOCK, GATE, MAILBOX, OTHER.
  type             String
  /// "Front door", "Side gate" - disambiguates within a type; not part of
  /// the versioning key.
  label            String?
  sealedCode       String
  version          Int
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  createdByStaffId String?
  createdAt        DateTime  @default(now())

  unit      Unit       @relation(fields: [unitId], references: [id])
  createdBy StaffUser? @relation(fields: [createdByStaffId], references: [id])

  @@unique([unitId, type, version])
  @@index([unitId, type, effectiveTo])
}

model Appliance {
  id           String    @id @default(cuid())
  unitId       String
  /// REFRIGERATOR, RANGE, DISHWASHER, WASHER, DRYER, WATER_HEATER, HVAC,
  /// MICROWAVE, OTHER.
  category     String
  make         String?
  model        String?
  serialNumber String?
  installedOn  DateTime? @db.Date
  /// Only meaningful for category = HVAC; nullable for everything else
  /// rather than a second table for one field.
  filterSize   String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([unitId])
}

model UtilityAccount {
  id                         String   @id @default(cuid())
  unitId                     String
  /// ELECTRIC, GAS, WATER, SEWER, TRASH, OTHER.
  type                       String
  provider                   String
  accountNumber              String?
  nameOnAccountDuringTenancy String?
  /// Who the account reverts to (and whether it does at all) between
  /// tenancies - the landlord-revert question PROP-03 names explicitly,
  /// since a vacant unit with no utilities on is how a pipe freezes
  /// unnoticed.
  nameOnAccountVacancy       String?
  landlordRevertAgreement    Boolean  @default(false)
  notes                      String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([unitId])
}

/// Where to physically stop the water/power/gas in an emergency (PROP-03,
/// master PRD's own active-leak walkthrough: "immediately shows the tenant
/// the water shutoff location with the photo stored in the unit record").
/// The photo itself is a Document (unitId, type SHUTOFF_PHOTO) - reusing
/// R-012's attachment/versioning/soft-delete rather than a second photo
/// column here.
model ShutoffLocation {
  id          String   @id @default(cuid())
  unitId      String
  /// WATER_MAIN, BREAKER_PANEL, GAS, OTHER.
  type        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, type])
  @@index([unitId])
}

// ---------------------------------------------------------------------------
// People & tenancy
// ---------------------------------------------------------------------------

/// Identity and account state. Secrets live on StaffCredential, never here,
/// so an ordinary `staffUser.findMany()` cannot leak a password hash or a TOTP
/// secret by accident. R-004 adds roles-as-data and the property/entity
/// assignment rows that scope them. There is no `isSuperuser` and there never
/// will be (D-5).
model StaffUser {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  phone                 String?
  active                Boolean   @default(true)
  deactivatedAt         DateTime?
  /// Sessions issued before this instant are rejected (R-003). Bumping it is
  /// how a password reset, a deactivation, or a "sign out everywhere" takes
  /// effect immediately - Auth.js Credentials sessions are JWTs and cannot be
  /// deleted server-side, so revocation is a watermark comparison instead.
  /// ROLE-06's "access killed within 1 minute" depends on this column.
  sessionsValidFrom     DateTime  @default(now())
  /// Per-user monetary ceilings (ROLE-02). Null falls back to the role's
  /// default; these exist so one manager can approve more than another
  /// without inventing a second manager role. Zero is a meaningful value -
  /// "may approve nothing" - which is why the fallback is on null, not on
  /// falsiness.
  approveWorkOrderCents Int?
  waiveFeeCents         Int?
  /// R-029 (MAINT-12): the on-call window. Both null means "not on call".
  /// A WINDOW rather than a boolean toggle, because the failure mode of a
  /// boolean is somebody forgetting to turn it off and being paged at 3am
  /// for a month - and because "who was on call last Tuesday" is a real
  /// question after an incident that a boolean cannot answer.
  onCallFrom            DateTime?
  onCallUntil           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  credential         StaffCredential?
  assignments        StaffAssignment[]
  assignmentsGranted StaffAssignment[] @relation("AssignmentGrantedBy")

  paymentsReceived                        Payment[]                    @relation("PaymentReceivedBy")
  chargesWaived                           Charge[]                     @relation("ChargeWaivedBy")
  utilityBillsAllocated                   UtilityBill[]                @relation("UtilityBillAllocatedBy")
  workOrdersApproved                      WorkOrder[]                  @relation("WorkOrderApprovedBy")
  workOrdersAssigned                      WorkOrder[]                  @relation("WorkOrderAssignedTo")
  workOrdersEntryPermissionLogged         WorkOrder[]                  @relation("WorkOrderEntryPermission")
  workOrdersClosed                        WorkOrder[]                  @relation("WorkOrderClosedBy")
  workOrderNotesWritten                   WorkOrderNote[]
  workOrderMessagesLinked                 WorkOrderMessageLink[]
  ticketsAcknowledged                     Ticket[]                     @relation("TicketAcknowledgedBy")
  tasksAssigned                           Task[]                       @relation("TaskAssignedTo")
  tasksCompleted                          Task[]                       @relation("TaskCompletedBy")
  inspectionsPerformed                    Inspection[]                 @relation("InspectionPerformedBy")
  noticesServed                           Notice[]                     @relation("NoticeServedBy")
  noticeDeliveriesServed                  NoticeDelivery[]             @relation("NoticeDeliveryServedBy")
  tenantConsentsRecorded                  TenantConsent[]              @relation("TenantConsentRecordedBy")
  messagesSent                            Message[]                    @relation("MessageSentBy")
  documentsUploaded                       Document[]                   @relation("DocumentUploadedBy")
  auditLogs                               AuditLog[]                   @relation("AuditLogActor")
  accessCodesCreated                      AccessCode[]
  messagesRouted                          UnroutedMessage[]            @relation("UnroutedMessageRoutedBy")
  templatesCreated                        MessageTemplate[]            @relation("TemplateCreatedBy")
  templatesUpdated                        MessageTemplate[]            @relation("TemplateUpdatedBy")
  translationsApproved                    MessageTemplateTranslation[] @relation("TranslationApprovedBy")
  paymentHoldsSet                         LeasePayer[]                 @relation("PaymentHoldSetBy")
  listingsCreated                         Listing[]                    @relation("ListingCreatedBy")
  screeningCriteriaCreated                ScreeningCriteria[]
  screeningReportsDecided                 ScreeningReport[]            @relation("ScreeningReportDecidedBy")
  screeningReportsAdverseActionOverridden ScreeningReport[]            @relation("ScreeningReportAdverseActionOverriddenBy")

  @@index([active])
}

model Tenant {
  id                String   @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  phone             String?
  active            Boolean  @default(true)
  notes             String?
  /// BCP-47, or null for "never said". Null is NOT the same as English: it
  /// means nobody asked, which is the honest state for every tenant onboarded
  /// before R-049 and the reason `languageFor` treats it as the default
  /// rather than recording a preference the tenant never expressed.
  preferredLocale   String?
  /// Same revocation watermark as StaffUser. A tenant who moves out or whose
  /// magic link leaked has every issued session invalidated by bumping this.
  sessionsValidFrom DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  credential             TenantCredential?
  leaseTenants           LeaseTenant[]
  workOrderVerifications WorkOrderVerification[]
  leasePayers            LeasePayer[]
  tickets                Ticket[]
  threads                Thread[]
  messages               Message[]               @relation("MessageFromTenant")
  documents              Document[]
  consents               TenantConsent[]

  @@index([lastName, firstName])
  @@index([email])
}

/// Financially liable on the ledger, no portal access to maintenance or
/// comms (LEASE-06). A guarantor guarantees exactly one lease; a person
/// guaranteeing two leases is two rows, which is the honest shape - their
/// liability is per-lease.
model Guarantor {
  id        String   @id @default(cuid())
  leaseId   String
  firstName String
  lastName  String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lease Lease @relation(fields: [leaseId], references: [id])

  @@index([leaseId])
}

model Vendor {
  id                 String    @id @default(cuid())
  name               String
  /// Free-form trade tags ("plumbing", "hvac"). Not an enum - the trade list
  /// is operator data, and a new trade should not need a migration.
  trades             String[]
  contactName        String?
  email              String?
  phone              String?
  serviceAreas       String[]
  licenseNumber      String?
  /// Payment is blocked or flagged without a W-9 on file (MAINT-11). The W-9
  /// itself is a Document; this is the flag the dispatch check reads.
  w9OnFile           Boolean   @default(false)
  coiExpiresOn       DateTime? @db.Date
  /// Lower sorts first within a trade. Null = no stated preference.
  preferredRank      Int?
  /// R-029 (MAINT-12's "emergency vendor list per trade"): this vendor
  /// answers at 3am. A separate flag from `active` because the plumber you
  /// use for a scheduled cartridge swap is often not the one who picks up
  /// on a Sunday, and dispatching an emergency to somebody who will not
  /// answer costs the hours that matter most.
  emergencyAvailable Boolean   @default(false)
  active             Boolean   @default(true)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workOrders    WorkOrder[]
  bids          WorkOrderBid[]
  verifications WorkOrderVerification[]
  threads       Thread[]
  messages      Message[]               @relation("MessageFromVendor")
  documents     Document[]

  @@index([active])
}

model Lease {
  id                    String             @id @default(cuid())
  propertyId            String
  unitId                String
  status                LeaseStatus        @default(DRAFT)
  startsOn              DateTime           @db.Date
  endsOn                DateTime?          @db.Date
  rentCents             Int
  /// Day of month rent is due, property-local. The Stripe subscription anchor
  /// is computed from this in local time, then expressed to Stripe (D-11).
  rentDueDay            Int                @default(1)
  /// How a PART month is prorated (R-042, PAY-08). A term of the contract,
  /// so it lives on the contract: leases genuinely disagree, and the two
  /// methods differ by real money - a 9-day February move-in on $1,500 is
  /// $482.14 on actual days and $450.00 on a flat 30-day month.
  prorationMethod       ProrationMethod    @default(ACTUAL)
  depositCents          Int                @default(0)
  /// HOW the deposit is held, which `depositCents` alone cannot say (R-041).
  ///
  /// CASH is a liability - the tenant's money, held on trust, returnable
  /// minus what can lawfully be proved, and in several states escrowed and
  /// interest-bearing (D-4). SURETY_BOND means the tenant paid a premium to a
  /// third party and this landlord holds NOTHING. NONE means no deposit.
  ///
  /// A database CHECK enforces that anything other than CASH holds zero: the
  /// contradiction is what sends somebody hunting at move-out for money that
  /// was never collected.
  depositArrangement    DepositArrangement @default(CASH)
  /// What THIS LEASE provides for if a payment is returned (R-039a, PAY-02).
  ///
  /// Null means the lease is silent, which means no fee - not zero, and
  /// deliberately not a default. A fee the tenant never agreed to is
  /// unenforceable at exactly the moment somebody needs to enforce it.
  ///
  /// The statutory ceiling is NOT here: `JurisdictionRule.nsfFeePermitted`
  /// and `nsfFeeMaxCents` clamp this (D-4), so a state that forbids or caps
  /// the fee overrides the lease without anybody editing a lease.
  nsfFeeCents           Int?
  /// An owner policy that overrides the collection method (R-039a, D-29).
  /// `send_invoice` allows partial payments; this refuses them anyway, which
  /// is what an owner wants for a tenant whose payment plan has already
  /// failed once. On the lease because it is a decision about a tenancy.
  requireFullBalance    Boolean            @default(false)
  isMonthToMonth        Boolean            @default(false)
  /// Rate applied on MTM rollover (LEASE-09). Null = keep the current rent.
  mtmRentCents          Int?
  /// Who pays which utility. Shape is a lease-template concern (R-063), not
  /// something to normalize before there is a template to normalize against.
  utilityResponsibility Json?
  moveInAt              DateTime?
  moveOutAt             DateTime?
  /// Notice to end the tenancy has been given - by either side. A FACT
  /// about an active lease, not a status of it; see LeaseStatus's own
  /// comment for why.
  noticeGivenAt         DateTime?
  /// Who gave it. A tenant giving notice and a landlord giving notice have
  /// completely different downstream consequences (LEASE-09's renewal
  /// flags, R-062's notice periods), and a bare timestamp cannot tell them
  /// apart.
  noticeGivenBy         NoticeParty?
  terminationReason     String?

  /// R-033. Where this tenancy came from - see LeaseOrigin.
  origin                LeaseOrigin           @default(APPLICATION)
  /// RISK-08. Defaults to NOT_APPLICABLE, which is correct for the ordinary
  /// path and is exactly why the inherited intake refuses to accept it: an
  /// inherited tenancy whose deposit status was never stated would sit here
  /// looking settled.
  depositTransferStatus DepositTransferStatus @default(NOT_APPLICABLE)
  /// What the seller actually said, in whoever's words. Free text on
  /// purpose - "Jim says it was credited at closing, chasing the settlement
  /// statement" is the real shape of this information.
  depositTransferNote   String?
  /// RISK-08's estoppel-style confirmation: the tenant has agreed that the
  /// terms recorded here are the terms they actually have. Until this is
  /// set, an inherited lease's rent and dates are our best reading of
  /// somebody else's paperwork, not an agreed fact.
  estoppelConfirmedAt   DateTime?

  /// When the lease actually became ACTIVE. Deliberately separate from
  /// `startsOn`: a lease activated three days late still started on the
  /// first, and an audit that conflated the two would misdate the tenancy.
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  property         Property          @relation(fields: [propertyId], references: [id])
  unit             Unit              @relation(fields: [unitId], references: [id])
  leaseTenants     LeaseTenant[]
  guarantors       Guarantor[]
  leasePayers      LeasePayer[]
  charges          Charge[]          @relation("ChargeLease")
  /// Late fees assessed against this lease's own unlinked-rent balance,
  /// rather than against a specific Charge (R-050b). See `Charge.assessedOnLeaseId`.
  assessedLateFees Charge[]          @relation("ChargeAssessedOnLease")
  payments         Payment[]
  ledgerEntries    LedgerEntry[]
  deposits         Deposit[]
  recurringCharges RecurringCharge[]
  tickets          Ticket[]
  inspections      Inspection[]
  threads          Thread[]
  notices          Notice[]
  documents        Document[]

  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([endsOn])
}

/// A lease has one row per adult occupant (LEASE-06). Separate from
/// LeasePayer: every adult is jointly liable, but not every adult is a
/// distinct Stripe payer.
model LeaseTenant {
  id        String   @id @default(cuid())
  leaseId   String
  tenantId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  lease  Lease  @relation(fields: [leaseId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([leaseId, tenantId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Jobs and events (R-006)
//
// NOT a second work queue. D-9 forbids inventing one, and this is not one:
// `Task` is the queue of work a PERSON has to do, and everything below is the
// record of work a MACHINE has done. A staff member never sees a JobRun.
//
// Two idempotency mechanisms, because there are two distinct failure modes:
//
//   OutboxEvent + EventConsumption - "this event must reach each consumer
//   exactly once", even though delivery is at-least-once.
//
//   JobRun - "this job must run once per property per local day", even though
//   the cron ticks hourly, fires twice through a fall-back hour, and may be
//   late or retried.
// ---------------------------------------------------------------------------

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Transactional outbox. An event is written in the SAME transaction as the
/// change that caused it, so the two cannot disagree: no event for a change
/// that was rolled back, and no change that failed to announce itself. A
/// dispatcher publishes them afterwards.
///
/// The alternative - emitting after commit - drops events whenever the process
/// dies in the gap, and drops them silently.
model OutboxEvent {
  id            String    @id @default(cuid())
  /// Event name from packages/core/events. A closed vocabulary, for the same
  /// reason audit actions are.
  type          String
  /// What the event is about, so a consumer can load it without the payload
  /// having to carry the whole record.
  aggregateType String
  aggregateId   String
  /// Scopes the event for R-004 filtering, and lets a per-property job pick up
  /// only its own. Null for portfolio-level events.
  propertyId    String?
  payload       Json
  /// When the thing happened, which is not when the row was written and not
  /// when it was published.
  occurredAt    DateTime  @default(now())
  publishedAt   DateTime?
  attempts      Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())

  property      Property?          @relation(fields: [propertyId], references: [id])
  consumptions  EventConsumption[]
  notifications Notification[]

  /// The dispatcher's query: unpublished, oldest first.
  @@index([publishedAt, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([propertyId])
}

/// One row per (event, consumer). The unique constraint IS the idempotency:
/// a consumer that has already handled an event cannot handle it again, no
/// matter how many times delivery is retried.
///
/// Recorded in the same transaction as the consumer's own effects, so a
/// consumer that half-succeeded is retried rather than skipped.
model EventConsumption {
  id          String   @id @default(cuid())
  eventId     String
  /// Stable consumer name. Renaming one makes it re-consume every event it
  /// has already handled, which is why the name belongs in code review.
  consumer    String
  processedAt DateTime @default(now())

  event OutboxEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, consumer])
  @@index([consumer])
}

/// The ledger of scheduled work. One row per (job, property, local day), which
/// is what makes a nightly job run exactly once even though the cron ticks
/// hourly and `isDue` stays true for the rest of the local day.
///
/// `businessDate` is a property-LOCAL calendar day (D-3), never a UTC one.
model JobRun {
  id           String       @id @default(cuid())
  jobType      String
  /// Null for a portfolio-wide job that is not run per property.
  propertyId   String?
  businessDate DateTime     @db.Date
  status       JobRunStatus @default(RUNNING)
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  /// Free-form result summary - counts, ids touched. Small enough to read in
  /// a support conversation, not a log stream.
  result       Json?
  error        String?
  attempts     Int          @default(1)

  property Property? @relation(fields: [propertyId], references: [id])

  @@index([jobType, businessDate])
  @@index([propertyId, businessDate])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Authorization (R-004)
//
// Roles-as-data, per D-5. A role is a row holding a set of permission keys;
// the keys themselves are a closed vocabulary in packages/core/rbac because
// code is what checks them, and a permission no code reads is a lie.
//
// THERE IS NO SUPERUSER AND THERE NEVER WILL BE (D-5). Unrestricted access is
// an ordinary StaffAssignment row with the `owner` role and a null scope -
// grantable, revocable, and visible in the audit log like anything else.
// Never add an `isSuperuser` column, and never add a short-circuit to can(),
// propertyScope() or checkMonetaryAuthority().
// ---------------------------------------------------------------------------

model Role {
  id                           String   @id @default(cuid())
  /// Stable machine key: owner, manager, maintenance_tech, read_only,
  /// tenant, guarantor. Code refers to roles by this, never by name or id.
  key                          String   @unique
  name                         String
  description                  String
  /// Permission keys from packages/core/rbac. Data rather than a join table:
  /// the vocabulary is fixed in code, so a Permission table would only ever
  /// mirror a TypeScript union with extra joins. ROLE-07 puts a custom role
  /// builder out of scope for v1, so nothing needs to browse the catalogue.
  permissions                  String[]
  /// Default ceilings for staff holding this role, overridable per user
  /// (ROLE-02). Null means "no authority at all" rather than "unlimited" -
  /// the safe reading when a value is missing.
  defaultApproveWorkOrderCents Int?
  defaultWaiveFeeCents         Int?
  /// Seeded roles the product depends on. Guards against deleting `owner`
  /// and locking everyone out.
  system                       Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  assignments StaffAssignment[]
}

/// One grant of one role over one scope. A staff user may hold several.
///
/// Scope is expressed by which column is set:
///   both null           - every property in the portfolio (D-5's owner)
///   legalEntityId set   - every property owned by that entity
///   propertyId set      - that property only (ROLE-04)
///
/// Both set at once is meaningless and rejected by a check constraint in the
/// migration, because a half-understood scope is how a "property-scoped" user
/// quietly sees everything.
model StaffAssignment {
  id               String    @id @default(cuid())
  staffUserId      String
  roleId           String
  legalEntityId    String?
  propertyId       String?
  /// Who granted it and why - a permission change is a privileged action
  /// (ROLE-03) and the audit trail starts with the row itself.
  grantedByStaffId String?
  grantedAt        DateTime  @default(now())
  /// Revocation is a timestamp, never a delete: ROLE-06 requires that
  /// deactivation preserve all history. A revoked assignment stops granting
  /// anything on the next request, because permissions are read per request.
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  staffUser   StaffUser    @relation(fields: [staffUserId], references: [id])
  role        Role         @relation(fields: [roleId], references: [id])
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id])
  property    Property?    @relation(fields: [propertyId], references: [id])
  grantedBy   StaffUser?   @relation("AssignmentGrantedBy", fields: [grantedByStaffId], references: [id])

  @@index([staffUserId, revokedAt])
  @@index([propertyId])
  @@index([legalEntityId])
}

// ---------------------------------------------------------------------------
// Authentication (R-003)
//
// Secrets are isolated from their identity rows on purpose: StaffUser and
// Tenant are read constantly by ordinary product code, and a password hash
// that rides along on every one of those reads eventually lands in a log, a
// serialized payload, or a debug dump. Fetching a credential requires asking
// for it by name.
//
// Three things are never stored in plaintext here: passwords (scrypt hash),
// MFA secrets (AES-256-GCM, key derived from AUTH_SECRET) and single-use
// tokens (SHA-256 hash). A dump of this database yields no working magic link
// and no usable authenticator seed.
// ---------------------------------------------------------------------------

enum AuthTokenPurpose {
  TENANT_MAGIC_LINK
  STAFF_PASSWORD_RESET
  TENANT_PASSWORD_RESET
  /// Issued after a correct staff password, redeemed by the MFA step. It
  /// exists so the second factor is a separate request that does not carry the
  /// password again - no re-prompting the user, and no password sitting in a
  /// hidden form field waiting to be autofilled or screenshotted. Lives in an
  /// httpOnly cookie, never in a URL.
  STAFF_MFA_CHALLENGE
  /// D-6: a vendor gets a signed, expiring, scoped work-order link and never
  /// an account. R-025 built the dispatch flow on top of this purpose - it
  /// does NOT invent a parallel VendorLink token table.
  ///
  /// UNIQUE AMONG PURPOSES: this one is multi-use until it expires (D-16).
  /// `consumedAt` stays null for its whole life and `redeemToken()` is
  /// deliberately NOT the verifier - see lib/vendors/link.ts. Every other
  /// purpose here is single-use and must stay that way.
  VENDOR_WORK_ORDER
  /// R-026: a request for a PRICE, before anybody is assigned - MAINT-04's
  /// bid-collection workflow. A SEPARATE purpose from VENDOR_WORK_ORDER on
  /// purpose: a dispatch link is one-per-work-order and reissuing revokes
  /// the previous one (D-16), whereas bids need N vendors holding live links
  /// to the same work order at the same time. Sharing the purpose would have
  /// meant weakening that invariant for every dispatch link in the product.
  VENDOR_BID
  /// R-032c: the tenant's "was this fixed?" (MAINT-07), answerable without a
  /// login. Scoped to one work order, one tenant and one ROUND — it opens no
  /// portal session, reads no document and moves no money, which is what
  /// makes a seven-day lifetime defensible where a session would not be.
  ///
  /// MULTI-USE until it expires, like VENDOR_WORK_ORDER and for the same
  /// reason: a tenant who taps, gets distracted and comes back must not find
  /// it dead. The ANSWER is still once-only — the unique index on
  /// (workOrderId, round) enforces that, not the token.
  TENANT_VERIFY
  /// R-046: pay rent straight from a reminder, with no login (PAY-01).
  ///
  /// Grants ONE standalone page and ONE action, and deliberately NO portal
  /// session (D-45) - a leaked one can see that lease's balance and pay that
  /// lease's rent, and can reach nothing else in the portal.
  ///
  /// MULTI-USE until it expires, like VENDOR_WORK_ORDER and TENANT_VERIFY: a
  /// tenant who taps, checks their bank and comes back must not find it
  /// dead. Paying twice is prevented by the balance itself going to zero,
  /// not by burning the token.
  TENANT_PAY_LINK
  /// R-058: a prospect's identical pre-screening questions (move date,
  /// occupants, pets, income range, prior evictions), answerable with no
  /// account - the prospect has none. SINGLE-USE, unlike its three
  /// multi-use siblings above: those exist so a distracted return visit
  /// finds a live link, which this ALSO needs (checkToken() is read
  /// non-consumingly for the page itself) - but here the single ANSWER a
  /// prospect ever gives is what the token itself guards, burned only when
  /// the answers are actually submitted, not when the page is opened.
  PROSPECT_PRESCREEN
  /// R-059: one adult's own application - their form, their document
  /// uploads, their fee payment, all scoped to their own `Applicant.id`
  /// (subjectId), never to the `Application` group as a whole.
  ///
  /// MULTI-USE until it expires, like VENDOR_WORK_ORDER/TENANT_VERIFY/
  /// TENANT_PAY_LINK: a household gathering pay stubs and ID scans across
  /// several sittings must not find the link dead partway through -
  /// "progress is saved" is the PRD's own line. Submission is once-only by
  /// business state (`Applicant.completedAt`), the same shape
  /// `prescreenLinkStatus`'s `already_answered` check already uses on top
  /// of a token that is still structurally alive - not by burning the
  /// token, which would also kill the ability to come back and check fee
  /// status after paying.
  ///
  /// FIVE DAYS - a deliberate middle point, not a copy of either neighbor.
  /// TENANT_PAY_LINK's three days is short BECAUSE it only shows a balance
  /// and takes a payment; TENANT_VERIFY's seven is long BECAUSE it moves no
  /// money and opens no document. This purpose does both of those things at
  /// once (uploads ID/income documents AND can pay a fee), which argues
  /// shorter than seven, while a real household needs more than three days
  /// to coordinate finding pay stubs and a photo ID for every adult.
  APPLICATION_LINK
}

model StaffCredential {
  id                String    @id @default(cuid())
  staffUserId       String    @unique
  /// scrypt, encoded as `scrypt$N$r$p$salt$hash`. Never a bare digest.
  passwordHash      String
  passwordUpdatedAt DateTime  @default(now())
  /// AES-256-GCM ciphertext of the TOTP secret. Null until enrolment starts.
  mfaSecret         String?
  /// Set only once a correct code has been entered - possessing a secret is
  /// not the same as having proved possession of the device.
  mfaEnrolledAt     DateTime?
  /// SHA-256 hashes of single-use recovery codes. Removed as they are spent.
  mfaRecoveryCodes  String[]
  /// Account lockout. Per-account, so credential stuffing against one inbox
  /// cannot be spread across IPs to evade the per-IP limiter.
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  staffUser StaffUser @relation(fields: [staffUserId], references: [id])
}

/// A tenant's password is optional by design (ROLE-05): magic link is the
/// primary path because friction is what keeps tenants off the portal, and a
/// tenant who never sets a password must still be able to get in.
model TenantCredential {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  passwordHash      String?
  passwordUpdatedAt DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

/// One table for every short-lived single-use token in the product - tenant
/// magic links, password resets, and vendor work-order links. Deliberately not
/// three tables: they differ by purpose and subject, not by shape, and D-9's
/// lesson about parallel queues applies just as well to parallel token stores.
///
/// `tokenHash` is a SHA-256 of the token that was actually sent; the raw value
/// exists only in the URL. Single use is enforced by `consumedAt`, and the
/// consuming update is conditional on it still being null so two simultaneous
/// clicks cannot both succeed.
model AuthToken {
  id          String           @id @default(cuid())
  purpose     AuthTokenPurpose
  tokenHash   String           @unique
  /// "Tenant", "StaffUser", "WorkOrder" - what the token grants access to.
  subjectType String
  subjectId   String
  expiresAt   DateTime
  consumedAt  DateTime?
  /// Where the request to issue it came from, for abuse investigation.
  requestedIp String?
  /// Purpose-specific extras - the vendor link's scope, for instance.
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@index([purpose, subjectId])
  @@index([expiresAt])
}

/// Fixed-window request counter, keyed by something like `login:ip:1.2.3.4`.
///
/// ponytail: DB-backed fixed window, not a sliding window or a token bucket.
/// It is exact enough to stop credential stuffing at this scale and needs no
/// Redis. Move to Upstash/Redis if login volume ever makes a write-per-attempt
/// look expensive - the interface in packages/core/auth is the seam.
model RateLimitCounter {
  key             String   @id
  windowStartedAt DateTime
  count           Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt])
}

// ---------------------------------------------------------------------------
// Money
//
// The two-payer shape (OQ-2, answered 2026-08-01 "unsure / possible later";
// OQ-12 for the Stripe mechanics). A Stripe invoice has exactly one payer, so
// a rent obligation split between a housing authority and a tenant cannot be
// one Stripe invoice. LeasePayer is therefore one Stripe Customer plus one
// Subscription each, and PayerAllocation splits each Charge across them so
// the lease still shows ONE balance in our projection.
//
// An ordinary lease is exactly one LeasePayer holding the whole charge. There
// is one code path, not two: allocation always happens, and for a
// single-payer lease it allocates the full amount to that payer. Nothing in
// R-002 knows what a housing authority is - the voucher FEATURES
// (recertification proration, bulk HAP deposit reconciliation, abatement, HQS
// re-inspection deadlines, and "dunning never pursues the HAP portion") are
// R-048's, and R-048 stays gated on OQ-2.
// ---------------------------------------------------------------------------

model LeasePayer {
  id                      String           @id @default(cuid())
  leaseId                 String
  propertyId              String
  payerType               PayerType
  /// Set when payerType = TENANT. Null for a housing authority or any other
  /// external payer, which is named by `externalPayerName` instead.
  tenantId                String?
  externalPayerName       String?
  /// The payer's default share of monthly rent, in cents. Null means "the
  /// remainder" - which is how a single-payer lease works without anyone
  /// having to keep a number in sync with the rent. Historical shares live on
  /// PayerAllocation, so a mid-stream recertification change never rewrites
  /// what was already billed.
  portionCents            Int?
  /// One Stripe Customer and one Subscription per payer (OQ-12). Null until
  /// R-034 provisions them.
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  /// R-036: collection is on hold for this payer - a legal-action hold
  /// (PAY-12), or an owner pausing deliberately. Distinct from `active`,
  /// which means the payer is no longer a payer at all: a paused payer still
  /// owes the money, we are simply not collecting it, and PAY-12 is explicit
  /// that in many states accepting a payment after serving notice voids the
  /// notice. R-047 owns the per-tenant switches that set this; R-036 only
  /// makes Stripe agree with it.
  /// How this payer is collected from (D-29, answering OQ-11).
  ///
  /// PER PAYER, and it switches: Stripe cannot do autopay and partial
  /// payments on one subscription, so a payer on autopay sits on
  /// `charge_automatically` and one who needs to pay in parts sits on
  /// `send_invoice`. The switch is guarded - see packages/core/payments -
  /// because moving a payer while an invoice is still open lets the new
  /// mode bill the same period twice.
  collectionMethod        CollectionMethod @default(charge_automatically)
  /// The saved payment method autopay charges (R-039a, PAY-02).
  ///
  /// A record of what we told Stripe to use, not a second source of truth
  /// (D-11) - it lets a screen say "a card is on file" without a network call
  /// per lease. NEVER a card number, a last-four or an expiry: §6.6 keeps
  /// those inside Stripe-hosted fields, and storing a last-four starts down a
  /// road this product has no reason to be on.
  defaultPaymentMethodId  String?
  /// The day of the month autopay pulls (R-039a, PAY-02). Null means the day
  /// rent is due. A later day inside the grace period is what stops autopay
  /// firing on the 1st against an account that is paid on the 3rd.
  ///
  /// The 1-28 range is a CHECK; whether a given day is SAFE depends on the
  /// property's versioned grace period and lives in `debitDayDecision` (D-4).
  debitDay                Int?
  collectionPaused        Boolean          @default(false)
  /// PAY-12's legal-action controls (R-047). Three switches because they are
  /// genuinely different postures - see packages/core/payments/legal-hold.ts.
  ///
  /// `collectionPaused` above IS the block-online switch: it already pauses
  /// the Stripe subscription AND is already refused by the payment UI, which
  /// is the "both halves" the backlog insists on. These two are the ones it
  /// did not cover.
  ///
  /// DELIBERATELY NOT `Lease.requireFullBalance`, which looks like the same
  /// thing and is not: that is an owner's ordinary preference about a payer
  /// they will not take part payments from, set for commercial reasons and
  /// left on indefinitely. Lifting a legal hold must not silently clear it.
  blockPartialPayments    Boolean          @default(false)
  certifiedFundsOnly      Boolean          @default(false)
  /// Why the hold was placed, who placed it and when. Required whenever any
  /// switch is on: "we stopped taking this tenant's money" is the fact an
  /// eviction is later argued from, and a hold nobody can explain is worse
  /// than no hold.
  paymentHoldReason       String?
  paymentHoldSetAt        DateTime?
  paymentHoldSetByStaffId String?
  /// The rent we last successfully pushed to Stripe, in cents.
  ///
  /// NOT a copy of Stripe's truth - it is a record of our last INSTRUCTION,
  /// which is a different fact and a useful one: comparing it to the lease's
  /// current rent says "we have not told Stripe about this change yet"
  /// without an API call. Stripe remains the authority (D-11), and the
  /// lifecycle sweep still asks it; this is what makes a rent change
  /// detectable at all against a provider that has no memory of its own.
  stripeAmountCents       Int?
  /// When the lifecycle sweep last made Stripe agree with this lease, and
  /// what it did. Operational breadcrumbs for the Billing Runs screen -
  /// deliberately NOT a second source of truth about the subscription, which
  /// is Stripe's.
  lastSyncedAt            DateTime?
  lastSyncAction          String?
  lastSyncError           String?
  active                  Boolean          @default(true)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  lease            Lease             @relation(fields: [leaseId], references: [id])
  property         Property          @relation(fields: [propertyId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  /// Restrict, like every other evidence key here: who placed a payment hold
  /// is part of explaining an eviction it contributed to.
  paymentHoldSetBy StaffUser?        @relation("PaymentHoldSetBy", fields: [paymentHoldSetByStaffId], references: [id], onDelete: Restrict)
  allocations      PayerAllocation[]
  payments         Payment[]
  ledgerEntries    LedgerEntry[]

  @@unique([stripeCustomerId])
  @@unique([stripeSubscriptionId])
  @@index([leaseId])
  @@index([propertyId])
}

/// What core decided this charge is worth and why. Charges originate here,
/// not in Stripe: if a statute could change the number, core computes it and
/// pushes it to Stripe as an invoice item (D-12).
model Charge {
  id                  String     @id @default(cuid())
  propertyId          String
  leaseId             String
  type                ChargeType
  amountCents         Int
  description         String
  /// Property-local calendar day the charge is due (D-3).
  dueOn               DateTime   @db.Date
  periodStart         DateTime?  @db.Date
  periodEnd           DateTime?  @db.Date
  /// The rule version that produced a statutory amount - the late fee cap in
  /// force on the day it was assessed (D-12). Null for amounts no statute
  /// touches, like agreed pet rent.
  jurisdictionRuleId  String?
  recurringChargeId   String?
  /// The utility bill this charge is a share of (R-042, PAY-08). What makes a
  /// RUBS charge defensible: the tenant's invoice line carries the
  /// arithmetic, and this carries the bill it was worked out from.
  utilityBillId       String?
  /// The job a tenant is being billed for (R-031, MAINT-07). The same idea as
  /// `utilityBillId` one line up: the charge's description carries the
  /// arithmetic, and this carries the evidence it was worked out from - the
  /// vendor's invoice and the completion photos already hanging off that work
  /// order. A chargeback whose job cannot be named is not defensible.
  ///
  /// Also the idempotency key. It carries a PARTIAL UNIQUE INDEX so one job
  /// can be billed exactly once, enforced by the database rather than by a
  /// read-then-write check two concurrent submits would both pass.
  workOrderId         String?
  stripeInvoiceId     String?
  stripeInvoiceItemId String?
  /// The charge this one was assessed ON - a late fee pointing at the
  /// overdue rent that produced it (R-040). `lateFeeFor()` returns the
  /// CUMULATIVE fee as of a date, so a scheduled assessment has to charge
  /// the delta against what this rent charge has already attracted; without
  /// this link that question cannot be asked. Also the spine of PAY-04's
  /// waiver-pattern report.
  assessedOnChargeId  String?
  /// What a returned-payment fee was assessed on (R-039a). The counterpart of
  /// `assessedOnChargeId`, which answers for a late fee. Carries a PARTIAL
  /// UNIQUE INDEX - one NSF fee per returned payment, enforced by the
  /// database, because Stripe redelivers and two concurrent deliveries would
  /// both pass a read-then-write check.
  assessedOnPaymentId String?
  /// What a late fee was assessed on when the rent it answers to has NO
  /// Charge row - ordinary subscription-billed rent, per D-11/D-40 (R-050b).
  /// The lease itself is the only thing left to anchor to.
  assessedOnLeaseId   String?
  /// WHICH rent-due cycle `assessedOnLeaseId` answers to. Unlike a real
  /// Charge's `dueOn`, unlinked rent is one lease-wide balance that can
  /// represent a different overdue cycle each time it's checked - this
  /// field is what keeps a fee assessed against last month's debt from
  /// being read as "already assessed" against a completely different one
  /// next month. `Charge.dueOn` on THIS row is already the day the fee
  /// itself was assessed, not this.
  assessedForDueOn    DateTime?  @db.Date
  waivedAt            DateTime?
  waivedByStaffId     String?
  waiveReason         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  property          Property          @relation(fields: [propertyId], references: [id])
  lease             Lease             @relation("ChargeLease", fields: [leaseId], references: [id])
  jurisdictionRule  JurisdictionRule? @relation(fields: [jurisdictionRuleId], references: [id])
  recurringCharge   RecurringCharge?  @relation(fields: [recurringChargeId], references: [id])
  /// The bill this share came out of (R-042, PAY-08). Restrict, like every
  /// other evidence key: the bill IS the defence of the charge, and deleting
  /// it would leave a tenant billed for a share of nothing.
  utilityBill       UtilityBill?      @relation(fields: [utilityBillId], references: [id], onDelete: Restrict)
  /// Restrict, like every other evidence key here: the job IS the defence of
  /// the chargeback, and deleting it would leave a tenant billed for a repair
  /// the record can no longer describe.
  workOrder         WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  waivedBy          StaffUser?        @relation("ChargeWaivedBy", fields: [waivedByStaffId], references: [id])
  assessedOn        Charge?           @relation("ChargeAssessedOn", fields: [assessedOnChargeId], references: [id], onDelete: Restrict)
  /// Restrict for the same reason as every other evidence-trail key: a
  /// payment a fee was assessed on cannot be deleted out from under the fee.
  assessedOnPayment Payment?          @relation("ChargeAssessedOnPayment", fields: [assessedOnPaymentId], references: [id], onDelete: Restrict)
  /// Restrict, like every other evidence-trail key: the lease a fee was
  /// assessed against cannot be deleted out from under the fee.
  assessedOnLease   Lease?            @relation("ChargeAssessedOnLease", fields: [assessedOnLeaseId], references: [id], onDelete: Restrict)
  assessedFees      Charge[]          @relation("ChargeAssessedOn")
  allocations       PayerAllocation[]
  ledgerEntries     LedgerEntry[]

  @@index([leaseId, dueOn])
  @@index([propertyId, dueOn])
  @@index([type])
  /// "What has this job cost the tenant", asked every time a work order page
  /// renders. The PARTIAL UNIQUE index that makes a chargeback idempotent
  /// lives in SQL only - Prisma cannot express a WHERE clause on an index, so
  /// it is invisible here and visible in the migration.
  @@index([workOrderId])
  @@index([assessedOnLeaseId, assessedForDueOn])
}

/// Splits one Charge across the lease's payers. The allocation rows for a
/// charge must sum to the charge amount; that is core's invariant to hold and
/// core's test to prove - Postgres cannot check a sum across sibling rows
/// without a trigger, and a trigger here would fire mid-insert on a
/// legitimately half-built allocation.
model PayerAllocation {
  id           String   @id @default(cuid())
  chargeId     String
  leasePayerId String
  amountCents  Int
  createdAt    DateTime @default(now())

  charge     Charge     @relation(fields: [chargeId], references: [id])
  leasePayer LeasePayer @relation(fields: [leasePayerId], references: [id])

  @@unique([chargeId, leasePayerId])
  @@index([leasePayerId])
}

model RecurringCharge {
  id                       String     @id @default(cuid())
  propertyId               String
  leaseId                  String
  type                     ChargeType
  amountCents              Int
  description              String
  /// Property-local day of month to post.
  dayOfMonth               Int        @default(1)
  startsOn                 DateTime   @db.Date
  endsOn                   DateTime?  @db.Date
  stripePriceId            String?
  stripeSubscriptionItemId String?
  active                   Boolean    @default(true)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  lease    Lease    @relation(fields: [leaseId], references: [id])
  charges  Charge[]

  @@index([leaseId])
  @@index([propertyId])
}

/// How a single-meter utility bill is split across the units it covers
/// (R-042, PAY-08). Chosen per bill because the right basis differs by
/// utility: water tracks occupancy, heat tracks floor area.
///
/// OCCUPANT COUNT IS DELIBERATELY ABSENT. `LeaseTenant` is adults-only by
/// design (LEASE-06), so a family of four reads as two - and a maintained
/// occupant column would be a number nobody updates when a baby arrives.
/// Billing on a stale count is worse than not offering the basis, and
/// occupant-based RUBS is the basis most likely to be challenged.
enum RubsMethod {
  EQUAL
  BEDROOMS
  SQUARE_FEET
}

/// One utility bill for a property with one meter and several units, and the
/// record of how it was split (R-042, PAY-08).
///
/// THE BILL ITSELF IS ATTACHED, as a `Document` (R-012's store, so it is
/// versioned, soft-deletable and retained like every other piece of
/// evidence). That is the whole defence of a RUBS charge: the tenant's
/// invoice line carries the arithmetic, and this carries the paper it was
/// worked out from. A share of a bill nobody can produce is a number a tenant
/// is asked to take on trust.
///
/// Several states restrict or forbid RUBS, which is why allocation is gated
/// on `JurisdictionRule.rubsPermitted` (D-4) rather than on anything here.
model UtilityBill {
  id                 String     @id @default(cuid())
  propertyId         String
  /// ELECTRIC, GAS, WATER, SEWER, TRASH, OTHER - the same vocabulary
  /// `UtilityAccount.type` uses.
  utilityType        String
  provider           String?
  /// What the bill covers, property-local calendar days (D-3).
  periodStart        DateTime   @db.Date
  periodEnd          DateTime   @db.Date
  amountCents        Int
  method             RubsMethod
  /// The scanned bill. Nullable because recording the bill and finding the
  /// PDF are two moments, and refusing the first until the second happens
  /// means the bill gets recorded nowhere.
  documentId         String?
  /// Set once the split has been charged. The idempotency guard: a bill
  /// allocated twice bills every tenant twice.
  allocatedAt        DateTime?
  allocatedByStaffId String?
  /// What the owner absorbed - the vacant units' share, which is never spread
  /// across the tenants. Recorded because a split that adds up to less than
  /// the bill is one somebody will eventually be asked to explain.
  landlordCents      Int?
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  property    Property   @relation(fields: [propertyId], references: [id])
  document    Document?  @relation("UtilityBillDocument", fields: [documentId], references: [id])
  allocatedBy StaffUser? @relation("UtilityBillAllocatedBy", fields: [allocatedByStaffId], references: [id])
  charges     Charge[]

  @@index([propertyId, periodEnd])
}

model Payment {
  id                    String         @id @default(cuid())
  propertyId            String
  leaseId               String
  /// Which payer's money this is. A voucher lease's HAP deposit and its
  /// tenant's portion are separate Payments against separate LeasePayers.
  leasePayerId          String
  channel               PaymentChannel
  status                PaymentStatus  @default(PENDING)
  amountCents           Int
  receivedAt            DateTime
  /// Required for every offline channel (PAY-05) - a cash payment with no
  /// named recipient is an unauditable cash payment. Nullable in the schema
  /// because Stripe-originated payments have no receiving staff member;
  /// core enforces the offline case.
  receivedByStaffId     String?
  checkNumber           String?
  stripePaymentIntentId String?
  stripeInvoiceId       String?
  reversedAt            DateTime?
  reversalReason        String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  property        Property      @relation(fields: [propertyId], references: [id])
  lease           Lease         @relation(fields: [leaseId], references: [id])
  leasePayer      LeasePayer    @relation(fields: [leasePayerId], references: [id])
  receivedBy      StaffUser?    @relation("PaymentReceivedBy", fields: [receivedByStaffId], references: [id])
  ledgerEntries   LedgerEntry[]
  /// Fees assessed because this payment came back (R-039a).
  assessedCharges Charge[]      @relation("ChargeAssessedOnPayment")

  @@unique([stripePaymentIntentId])
  @@index([leaseId, receivedAt])
  @@index([propertyId, receivedAt])
  @@index([status])
}

/**
 * Every Stripe webhook event this deployment has already handled (R-034).
 * THE IDEMPOTENCY GUARANTEE FOR MONEY. Stripe retries a webhook until it
 * gets a 2xx, and explicitly does not promise to deliver each event exactly
 * once - so without this table a single retried `invoice.payment_succeeded`
 * would credit a tenant twice, in an append-only ledger nobody can correct
 * by editing.
 * `stripeEventId` is the primary key rather than a surrogate with a unique
 * index on it. The insert IS the lock: two concurrent deliveries of the same
 * event both try to claim the row, one loses on the primary key, and the
 * loser stops. A check-then-write would let both pass the check.
 * Kept for events we IGNORE as well as ones we project, because "we saw it
 * and deliberately did nothing" is the answer to a support question that
 * silence cannot give.
 */
model ProcessedStripeEvent {
  stripeEventId String   @id
  type          String
  /// What happened: `projected` or `ignored`. Free text rather than an enum -
  /// this is an operational log, and a new outcome should not need a
  /// migration.
  outcome       String
  /// Why, when ignored. "unhandled event type customer.discount.created" is
  /// the whole answer somebody needs six months later.
  detail        String?
  /// Stripe's own timestamp for the event, so the log can be read in the
  /// order things happened rather than the order they arrived.
  occurredAt    DateTime
  processedAt   DateTime @default(now())

  @@index([occurredAt])
  @@index([type])
}

/// Append-only projection of Stripe (D-11). Rows are INSERTed by the webhook
/// pipeline (R-034) and never updated or deleted - a database trigger in the
/// migration enforces that, because "append-only by convention" is a property
/// that survives exactly until the first production incident. A correction is
/// a new REVERSAL row pointing at the entry it reverses.
///
/// A row here that Stripe does not know about is a reconciliation bug, not a
/// shortcut.
model LedgerEntry {
  id             String          @id @default(cuid())
  propertyId     String
  leaseId        String
  /// Null only for lease-level entries that belong to no single payer.
  leasePayerId   String?
  type           LedgerEntryType
  /// Signed. Positive increases the balance owed, negative reduces it.
  amountCents    Int
  description    String
  /// When the money event happened, per Stripe - not when we projected it.
  occurredAt     DateTime
  chargeId       String?
  paymentId      String?
  /// Set on a REVERSAL, pointing at the entry being reversed.
  reversesId     String?         @unique
  /// The Stripe event that produced this row. Indexed, not unique: one event
  /// can legitimately project to several entries. R-034 owns the
  /// processed-event log that makes webhook handling idempotent.
  stripeEventId  String?
  stripeObjectId String?
  createdAt      DateTime        @default(now())

  // RESTRICT, not the Prisma default SET NULL - see the R-034 migration's
  // own comment. This table's append-only trigger rejects every UPDATE, so a
  // SET NULL cascade could never actually run; RESTRICT says the true thing,
  // which is that a row the ledger points at cannot be deleted.
  property   Property     @relation(fields: [propertyId], references: [id])
  lease      Lease        @relation(fields: [leaseId], references: [id])
  leasePayer LeasePayer?  @relation(fields: [leasePayerId], references: [id], onDelete: Restrict)
  charge     Charge?      @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  payment    Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reverses   LedgerEntry? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy LedgerEntry? @relation("LedgerReversal")

  @@index([leaseId, occurredAt])
  @@index([propertyId, occurredAt])
  @@index([stripeEventId])
}

/// A liability, never income (PAY-07). `heldCents` is what is still held;
/// applied and refunded amounts account for the rest. The disposition
/// deadline is computed from the property's JurisdictionRule at move-out and
/// stored, so a later rule change never moves a deadline already running.
model Deposit {
  id                   String      @id @default(cuid())
  propertyId           String
  leaseId              String
  type                 DepositType @default(SECURITY)
  heldCents            Int
  receivedAt           DateTime?
  /// Set where the state requires a separate or escrow account (D-4).
  escrowAccountRef     String?
  interestAccruedCents Int         @default(0)
  /// Property-local statutory deadline, frozen at move-out (D-12).
  dispositionDueOn     DateTime?   @db.Date
  dispositionSentAt    DateTime?
  forwardingAddress    String?
  appliedCents         Int         @default(0)
  refundedCents        Int         @default(0)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  lease    Lease    @relation(fields: [leaseId], references: [id])

  @@index([leaseId])
  @@index([propertyId])
  @@index([dispositionDueOn])
}

// ---------------------------------------------------------------------------
// Maintenance
// ---------------------------------------------------------------------------

/// The tenant-facing request (D-10: tenants say "maintenance request";
/// "ticket" and "work order" are staff words and must not reach a tenant
/// route).
model Ticket {
  id                    String       @id @default(cuid())
  propertyId            String
  unitId                String
  leaseId               String?
  tenantId              String?
  source                TicketSource
  category              String
  description           String
  priority              Priority     @default(ROUTINE)
  status                TicketStatus @default(NEW)
  entryPermission       Boolean      @default(false)
  petWarning            Boolean      @default(false)
  /// Set when intake detects habitability language - mold, leak, no heat,
  /// sewage, infestation (MAINT-02, RISK-05). The response clock that hangs
  /// off this is the whole point of recording it.
  habitabilityFlag      Boolean      @default(false)
  firstResponseAt       DateTime?
  /// R-029 (NOTIF-05): somebody has SEEN this emergency and is acting on
  /// it. Deliberately distinct from firstResponseAt, which R-023 sets when
  /// triage makes a decision: a page acknowledged at 3am is not a triage
  /// decision, and conflating them would let the escalation clock be
  /// stopped by ordinary daytime queue work.
  acknowledgedAt        DateTime?
  acknowledgedByStaffId String?
  mergedIntoTicketId    String?
  closedAt              DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  property       Property    @relation(fields: [propertyId], references: [id])
  unit           Unit        @relation(fields: [unitId], references: [id])
  lease          Lease?      @relation(fields: [leaseId], references: [id])
  tenant         Tenant?     @relation(fields: [tenantId], references: [id])
  acknowledgedBy StaffUser?  @relation("TicketAcknowledgedBy", fields: [acknowledgedByStaffId], references: [id])
  mergedInto     Ticket?     @relation("TicketMerge", fields: [mergedIntoTicketId], references: [id])
  mergedTickets  Ticket[]    @relation("TicketMerge")
  workOrders     WorkOrder[]
  threads        Thread[]
  documents      Document[]
  messages       Message[]

  @@index([propertyId, status])
  @@index([unitId])
  @@index([status, priority])
}

model WorkOrder {
  id                             String          @id @default(cuid())
  propertyId                     String
  unitId                         String
  ticketId                       String?
  vendorId                       String?
  assignedStaffId                String?
  status                         WorkOrderStatus @default(SUBMITTED)
  priority                       Priority        @default(ROUTINE)
  scope                          String
  estimateCents                  Int?
  approvedByStaffId              String?
  approvedAt                     DateTime?
  /// The amount that was actually APPROVED, which is not the same as the
  /// current estimate: an estimate can be revised after approval, and the
  /// tolerance check in MAINT-04 has to measure actuals against what somebody
  /// with authority actually agreed to, not against a number that moved
  /// afterwards. Null means never approved.
  approvedAmountCents            Int?
  /// Set when an approver declines, and required (MAINT-04/ROLE-03) - a denial
  /// with no stated reason is indistinguishable from a mistake, and the PM
  /// needs to know whether to re-scope or drop it.
  denialReason                   String?
  /// An approver's "ask" - a question back to whoever requested it. Kept as a
  /// column rather than only an audit entry so the PM sees it on the work
  /// order without going to the trail.
  approvalQuestion               String?
  actualLaborCents               Int?
  actualMaterialsCents           Int?
  invoiceCents                   Int?
  scheduledStart                 DateTime?
  scheduledEnd                   DateTime?
  /// When the vendor magic link was last sent (R-025). Drives the
  /// no-response timer; reissuing the link resets it, because the clock
  /// measures silence since the most recent ask, not since the first.
  dispatchedAt                   DateTime?
  /// Null until the vendor answers. ACCEPTED / DECLINED / PROPOSED_TIME.
  vendorResponse                 String?
  vendorRespondedAt              DateTime?
  /// Free text from the vendor on a decline ("booked through next week") -
  /// what the PM reads before picking the fallback.
  vendorDeclineReason            String?
  /// A window the vendor proposed instead of accepting outright. Distinct
  /// from scheduledStart/End, which is what staff CONFIRMED - R-027 owns
  /// turning one into the other with an entry-notice check in between.
  proposedStart                  DateTime?
  proposedEnd                    DateTime?
  /// R-027: the entry notice served for this visit, when one was required.
  /// Null with a scheduled window means entry was permitted another way -
  /// the tenant granted permission, or it is an emergency.
  entryNoticeId                  String?
  /// The tenant told us to come in without formal notice (MAINT-05's
  /// "tenant grants logged permission-to-enter"). Recorded WITH who logged
  /// it and when, because "they said it was fine" is worth nothing in a
  /// dispute unless it was written down before the visit.
  entryPermissionGrantedAt       DateTime?
  entryPermissionLoggedByStaffId String?
  /// Set when staff scheduled inside the statutory notice window anyway.
  /// The reason is REQUIRED (audit action entry_notice.overridden is in
  /// REASON_REQUIRED) - this pair is the contemporaneous record an
  /// unlawful-entry claim is defended with, or lost on.
  entryOverrideReason            String?
  entryOverriddenAt              DateTime?
  /// MAINT-05: "a tenant no-show is logged (trip-charge/billback evidence)".
  tenantNoShowAt                 DateTime?
  completedAt                    DateTime?
  verifiedAt                     DateTime?
  /// R-030 (MAINT-07): the tenant said it was NOT resolved and the job went
  /// back to work. A timestamp rather than a boolean, because "when did this
  /// come back" is the question a repeat-issue report asks.
  reopenedAt                     DateTime?
  /// How many times this job has been sent back. Denormalized from the
  /// verification rows below because a work order list has to show it
  /// without loading each job's history, and it is what `round` on the next
  /// verification counts from.
  reopenCount                    Int             @default(0)
  closedAt                       DateTime?
  closedByStaffId                String?
  /// Drives the mid-lease chargeback flow (MAINT-07) - distinct from a
  /// move-out deposit deduction.
  tenantCaused                   Boolean         @default(false)
  warrantyClaim                  Boolean         @default(false)
  createdAt                      DateTime        @default(now())
  updatedAt                      DateTime        @updatedAt

  property                Property                @relation(fields: [propertyId], references: [id])
  unit                    Unit                    @relation(fields: [unitId], references: [id])
  ticket                  Ticket?                 @relation(fields: [ticketId], references: [id])
  vendor                  Vendor?                 @relation(fields: [vendorId], references: [id])
  assignedTo              StaffUser?              @relation("WorkOrderAssignedTo", fields: [assignedStaffId], references: [id])
  approvedBy              StaffUser?              @relation("WorkOrderApprovedBy", fields: [approvedByStaffId], references: [id])
  entryNotice             Notice?                 @relation("WorkOrderEntryNotice", fields: [entryNoticeId], references: [id])
  entryPermissionLoggedBy StaffUser?              @relation("WorkOrderEntryPermission", fields: [entryPermissionLoggedByStaffId], references: [id])
  closedBy                StaffUser?              @relation("WorkOrderClosedBy", fields: [closedByStaffId], references: [id])
  verifications           WorkOrderVerification[]
  threads                 Thread[]
  documents               Document[]
  bids                    WorkOrderBid[]
  messages                Message[]
  notes                   WorkOrderNote[]
  messageLinks            WorkOrderMessageLink[]
  /// At most one, by partial unique index - see `Charge.workOrderId`.
  chargebacks             Charge[]

  @@index([propertyId, status])
  @@index([unitId])
  @@index([vendorId])
  @@index([status, priority])
}

/// One vendor's price for one work order (MAINT-04's bid-collection
/// workflow, R-026). Its own table rather than columns on WorkOrder because
/// the whole point is comparing several at once.
/**
 * A message tagged onto a work order AFTER it was sent (COMM-06, R-032).
 * A SEPARATE TABLE, NOT AN UPDATE TO Message.workOrderId, because Message is
 * append-only at the database level (Message_append_only rejects every
 * UPDATE, not only DELETE) - the trigger exists precisely so nobody can
 * quietly rewrite what a tenant or vendor actually said, and "attach this
 * to a job" is a rewrite in exactly that sense if it touches the row. The
 * inline `Message.ticketId`/`workOrderId` columns stay the fast path for
 * the common case (a reply sent FROM a work order's own page, tagged at
 * INSERT time and never touched again); this table is only for a message
 * that already existed and was tagged afterward. Insert-only itself - there
 * is no correction path here either, only a new link.
 */
model WorkOrderMessageLink {
  id              String   @id @default(cuid())
  workOrderId     String
  /// Unique: a message belongs to at most one job. Attaching it twice, or
  /// to two different jobs, is a mistake this constraint refuses outright
  /// rather than silently double-counting it on two timelines.
  messageId       String   @unique
  linkedByStaffId String
  linkedAt        DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  message   Message   @relation(fields: [messageId], references: [id])
  linkedBy  StaffUser @relation(fields: [linkedByStaffId], references: [id])

  @@index([workOrderId])
}

/**
 * A staff-only internal note on a work order (COMM-06, R-032).
 * NOT a Message. It is never sent to a tenant or a vendor, belongs to no
 * Thread, and has no delivery status - inventing a fake channel and a fake
 * recipient to fit it into Message's shape would let a bug someday actually
 * transmit an internal note to the person it is about. A dedicated model
 * with none of that machinery cannot make that mistake.
 * Append-only in practice, like every other evidence row in this product: a
 * correction is a new note, not an edit to this one.
 */
model WorkOrderNote {
  id          String   @id @default(cuid())
  workOrderId String
  staffUserId String
  body        String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  staffUser StaffUser @relation(fields: [staffUserId], references: [id])

  @@index([workOrderId, createdAt])
}

/// A tenant's answer to "was this resolved?" (MAINT-07, R-030).
///
/// ITS OWN TABLE, NOT COLUMNS ON THE WORK ORDER, because a reopened job is
/// verified again: the same work order can carry "no, still leaking" in
/// March and "yes, fixed" in April, and columns would let the second answer
/// erase the first. The first answer is the evidence that the reopen was
/// justified, and this product's whole premise is that such evidence does
/// not get overwritten.
model WorkOrderVerification {
  id          String @id @default(cuid())
  workOrderId String
  tenantId    String

  /// WHO DID THE WORK BEING VERIFIED - captured here, at the moment of the
  /// answer, and never read off the work order later.
  ///
  /// This column is the whole reason MAINT-07 says reopen rate is captured
  /// "from day one". A reopened job is usually reassigned, so by the time
  /// anybody runs a vendor report the work order names whoever fixed it -
  /// not whoever's work came back. Reading the vendor off the work order
  /// would silently credit the second vendor with the first one's failure,
  /// and no amount of later analysis can recover the attribution once the
  /// column has moved. Null when the work was done in-house.
  vendorId String?

  /// Which round of work this verifies: 1 for the first completion, 2 after
  /// the first reopen. Makes "asked twice, answered once" answerable.
  round Int @default(1)

  /// The one-tap answer. False sends the job back.
  resolved    Boolean
  /// 1-5, optional and deliberately secondary - see the validator's comment.
  /// A required rating would put a second decision between a tenant and
  /// "yes, it is fixed", which is the tap that actually matters.
  rating      Int?
  comment     String?
  respondedAt DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  vendor    Vendor?   @relation(fields: [vendorId], references: [id])

  /// One answer per round. A tenant tapping twice is one answer, not two.
  @@unique([workOrderId, round])
  @@index([vendorId, resolved])
}

model WorkOrderBid {
  id          String    @id @default(cuid())
  workOrderId String
  vendorId    String
  /// Null until the vendor answers. A row exists from the moment the bid is
  /// REQUESTED, so "who was asked and never replied" is answerable - which
  /// is half of what a comparison view is for.
  amountCents Int?
  note        String?
  /// Set when a vendor answers "not interested" rather than quoting.
  declinedAt  DateTime?
  respondedAt DateTime?
  requestedAt DateTime  @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  vendor    Vendor    @relation(fields: [vendorId], references: [id])

  /// One bid per vendor per work order - asking twice is re-asking the same
  /// vendor, not collecting a second opinion from them.
  @@unique([workOrderId, vendorId])
  @@index([workOrderId])
}

// ---------------------------------------------------------------------------
// Evidence & communication
//
// Every message, notice, photo and approval is timestamped and exportable.
// The evidence trail is the product.
// ---------------------------------------------------------------------------

model Thread {
  id String @id @default(cuid())

  /// Deterministic identity, built by packages/core/comms - "tenant:<id>:
  /// property:<id>", "vendor:<id>:property:<id>", "property:<id>".
  ///
  /// A unique column rather than a compound unique across the nullable
  /// participant columns below, for the same two reasons R-016's
  /// idempotencyKey is one: Prisma cannot address a compound unique over
  /// nullable columns (the wall R-010 hit on JurisdictionRule.jurisdiction),
  /// and get-or-create has to be safe under concurrency. Two inbound texts
  /// arriving together must not produce two threads for one tenant, and a
  /// find-then-create without something to conflict on is exactly that race.
  key String @unique

  propertyId  String
  leaseId     String?
  tenantId    String?
  vendorId    String?
  ticketId    String?
  workOrderId String?
  subject     String?

  /// Denormalized from the newest Message, because the inbox sorts by it.
  /// Prisma can order by a relation COUNT but not by a related row's max
  /// timestamp, so the alternative is a raw query or loading every thread's
  /// messages to sort in memory. Written in the same transaction as the
  /// message that moves it, so the two cannot disagree.
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property  Property   @relation(fields: [propertyId], references: [id])
  lease     Lease?     @relation(fields: [leaseId], references: [id])
  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  vendor    Vendor?    @relation(fields: [vendorId], references: [id])
  ticket    Ticket?    @relation(fields: [ticketId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])
  messages  Message[]

  @@index([propertyId, lastMessageAt])
  @@index([leaseId])
  @@index([tenantId])
  @@index([vendorId])
}

/// An inbound message that could NOT be routed to a thread automatically
/// (R-017, COMM-01).
///
/// Two cases reach here, and neither may be guessed at:
///
///   UNKNOWN_SENDER - the number matches no active tenant or vendor. It could
///   be a wrong number, a new tenant whose phone was never recorded, or a
///   contractor texting from a personal phone.
///
///   AMBIGUOUS - the number matches more than one party. A couple sharing a
///   phone is ordinary, and picking one of them would file a conversation
///   under the wrong person's permanent record.
///
/// Filing either into someone's thread on a guess is a cross-tenant data leak
/// with an audit trail claiming it was theirs, so the engine refuses and a
/// human routes it. The row is the evidence in the meantime - dropping an
/// inbound message because it did not match a lookup is the one outcome that
/// is never acceptable.
///
/// Not a second task queue (D-9): this is a landing zone for the CONTENT.
/// The work item is an ordinary Task, created alongside it - except that a
/// Task requires a propertyId and an unknown sender has no property, which is
/// precisely why the content cannot simply live on the Task.
model UnroutedMessage {
  id          String           @id @default(cuid())
  channel     MessageChannel
  direction   MessageDirection @default(INBOUND)
  /// The sender as the provider reported it, normalized to E.164 where it
  /// could be. Stored as received when it could not be - an unparseable
  /// number is still evidence of who tried to make contact.
  fromAddress String
  body        String
  /// UNKNOWN_SENDER or AMBIGUOUS. Closed vocabulary in packages/core/comms.
  reason      String
  /// Provider message id (Twilio SID), for reconciliation and de-duplication
  /// if the provider redelivers the same webhook.
  externalId  String?          @unique
  receivedAt  DateTime
  createdAt   DateTime         @default(now())

  /// Set when a human files it into a thread. The Message created then
  /// carries the ORIGINAL receivedAt as its sentAt, so the transcript reads
  /// in the order things actually happened rather than the order somebody got
  /// around to sorting them out.
  routedMessageId String?   @unique
  routedAt        DateTime?
  routedByStaffId String?

  routedMessage Message?   @relation(fields: [routedMessageId], references: [id])
  routedBy      StaffUser? @relation("UnroutedMessageRoutedBy", fields: [routedByStaffId], references: [id])

  @@index([routedAt, receivedAt])
}

/// Immutable once written (COMM-05), enforced by the same trigger that
/// protects LedgerEntry and AuditLog. A logged phone call is a Message with
/// channel = CALL_LOG; contemporaneous notes carry legal weight, and a note
/// that can be edited later carries none. Delivery status is the one thing
/// that legitimately changes after the fact, so it lives on MessageDelivery
/// rather than on the immutable row.
model Message {
  id          String           @id @default(cuid())
  threadId    String
  channel     MessageChannel
  direction   MessageDirection
  body        String
  sentAt      DateTime
  staffUserId String?
  tenantId    String?
  vendorId    String?
  /// Provider message id (Twilio SID, Resend id) for delivery reconciliation.
  externalId  String?
  /// R-032 (COMM-06): which incident this message is EVIDENCE OF, distinct
  /// from which Thread it lives in. A tenant's thread is deliberately
  /// continuous across every ticket they ever raise (COMM-01) - it cannot
  /// itself say which message was about which leak. These are set at send
  /// time when the context is known (a reply sent from a work order's own
  /// page) or attached afterwards by a staff member curating the record
  /// (attachMessageToWorkOrder) - never inferred from a date range, which
  /// would file a message on a guess. Null is the ordinary case: most of a
  /// tenant's conversation is not about any one job.
  ticketId    String?
  workOrderId String?
  createdAt   DateTime         @default(now())

  thread        Thread                @relation(fields: [threadId], references: [id])
  staffUser     StaffUser?            @relation("MessageSentBy", fields: [staffUserId], references: [id])
  tenant        Tenant?               @relation("MessageFromTenant", fields: [tenantId], references: [id])
  vendor        Vendor?               @relation("MessageFromVendor", fields: [vendorId], references: [id])
  // RESTRICT, not the default SET NULL - see the migration's own comment:
  // Message's append-only trigger rejects the UPDATE a SET NULL cascade
  // would require, so RESTRICT is the only truthful option.
  ticket        Ticket?               @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  workOrder     WorkOrder?            @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  delivery      MessageDelivery?
  unrouted      UnroutedMessage?
  workOrderLink WorkOrderMessageLink?

  @@index([threadId, sentAt])
  @@index([externalId])
  @@index([ticketId])
  @@index([workOrderId])
}

/// The mutable half of a Message: what the provider told us afterwards.
/// Separated so the message body itself can be trigger-protected as evidence
/// while a webhook is still free to move QUEUED -> DELIVERED -> READ.
model MessageDelivery {
  id          String         @id @default(cuid())
  messageId   String         @unique
  status      DeliveryStatus @default(QUEUED)
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  failureCode String?
  /// Provider message id for an OUTBOUND message (R-017).
  ///
  /// Message.externalId already carries it for INBOUND, where the provider
  /// hands it over with the webhook and it can go on the immutable row at
  /// creation. Outbound is the other way round: the message is written to the
  /// log BEFORE it is transmitted - evidence before transmission - so the id
  /// does not exist yet when the immutable row is built. It belongs on the
  /// mutable half, which is where the reconciliation webhook looks anyway,
  /// and mirrors NotificationDelivery.externalId exactly.
  externalId  String?
  updatedAt   DateTime       @updatedAt

  message Message @relation(fields: [messageId], references: [id])

  @@index([status])
  @@index([externalId])
}

// ---------------------------------------------------------------------------
// Notification engine (NOTIF-01, NOTIF-02, R-016)
//
// NOTIF-01: "All modules emit events into one notification engine (recipient,
// channel per preference, template, delivery) - no module hand-rolls sending;
// all attempts/failures/retries logged centrally."
//
// The Message/MessageDelivery split above is the precedent this follows and
// for the same stated reason: the decided send is evidence and never changes,
// while what the provider said afterwards legitimately does. Notification is
// trigger-protected append-only alongside Message, LedgerEntry and AuditLog.
//
// Deliberately NOT written into Message/Thread: a Message requires a
// threadId, threading is R-017's item and does not exist, and a notification
// to a STAFF user ("approval needed") has no conversation to belong to. When
// R-017 lands it can join the two; nothing here forecloses that.
// ---------------------------------------------------------------------------

/// One decided send, on one channel, to one recipient. Immutable.
///
/// The recipient is stored as (recipientType, recipientId) plus `toAddress`
/// as actually used, rather than as four nullable foreign keys the way
/// Thread does it. Three reasons, in order of weight:
///
///   1. `toAddress` is the evidence. "We emailed jane@example.com on the 3rd
///      with this body" survives intact even if the Tenant row is later
///      merged, renamed or deactivated - which is stronger proof than a
///      foreign key to a record whose email has since changed.
///   2. NotificationPreference needs a unique constraint on
///      (recipient, category, channel), and a compound unique across nullable
///      columns is not addressable in Prisma (the same wall R-010 hit on
///      JurisdictionRule.jurisdiction). One (type, id) pair makes it trivial,
///      and the engine resolves a notification and its preference the same way.
///   3. A fifth recipient kind later is a vocabulary addition, not a fifth
///      nullable column plus a fifth back-relation on a fifth model.
///
/// The cost is real and accepted: no referential integrity on recipientId.
/// Tenants, staff, vendors and guarantors are deactivated rather than
/// deleted in this product, so an orphaned row is a theoretical case, and
/// point 1 means an orphan is still readable evidence rather than a dangling
/// pointer.
model Notification {
  id String @id @default(cuid())

  /// The idempotency key, and the hard invariant of this engine: the same
  /// logical notification can be requested any number of times and is sent
  /// once. Callers supply a natural key ("late-notice:<leaseId>:<date>"); the
  /// engine suffixes the channel, since one logical notification fans out to
  /// one row per channel.
  idempotencyKey String @unique

  /// Closed vocabulary in packages/core/notifications, not an enum here -
  /// adding a notification category must not require a migration, the same
  /// call Document.type and Task.type already make.
  category String
  channel  MessageChannel

  recipientType NotificationRecipientType
  recipientId   String
  /// The address as it was actually used - email address or E.164 phone. See
  /// this model's own comment, and Notice.addressOfRecord for the identical
  /// reasoning applied to served notices.
  toAddress     String

  templateKey String
  subject     String?
  body        String

  /// Null for a notification not tied to one property (a portfolio-wide
  /// digest, an account-level message). Quiet hours are resolved from this
  /// property's timezone when it is set - D-3.
  propertyId String?
  /// The OutboxEvent that caused this, when one did. A notification sent by a
  /// staff member's direct action has none.
  eventId    String?

  createdAt DateTime @default(now())

  property Property?             @relation(fields: [propertyId], references: [id])
  event    OutboxEvent?          @relation(fields: [eventId], references: [id])
  delivery NotificationDelivery?

  @@index([recipientType, recipientId, createdAt])
  @@index([propertyId, createdAt])
  @@index([category, createdAt])
}

/// The mutable half: what happened after the decision. Separated so the body
/// above can be trigger-protected as evidence while a provider webhook stays
/// free to move QUEUED -> SENT -> DELIVERED.
model NotificationDelivery {
  id               String         @id @default(cuid())
  notificationId   String         @unique
  status           DeliveryStatus @default(QUEUED)
  /// Why it was never sent, when status is SUPPRESSED. Closed vocabulary in
  /// packages/core/notifications (preference off, kill switch, quiet hours,
  /// no address on file).
  suppressedReason String?
  /// Set when status is DEFERRED: the earliest instant the drain job may send
  /// this. Quiet hours defer, they do not discard (NOTIF-05).
  sendAfter        DateTime?
  attempts         Int            @default(0)
  sentAt           DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  failureCode      String?
  /// Provider message id (Twilio SID, Resend id), for webhook reconciliation.
  externalId       String?
  updatedAt        DateTime       @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([status, sendAfter])
  @@index([externalId])
}

/// A per-recipient, per-category, per-channel override (NOTIF-02).
///
/// Absence means "the category default applies" - this table holds only what
/// somebody deliberately changed, so a new category does not need a backfill
/// of a row per person per channel before it can be sent.
///
/// A row turning off a LOCKED category is refused by the engine, not by a
/// constraint here: which categories are legally locked is product policy
/// that changes with the law (NOTIF-02 names legal notices and emergency
/// maintenance), and a check constraint would need a migration to follow it.
model NotificationPreference {
  id            String                    @id @default(cuid())
  recipientType NotificationRecipientType
  recipientId   String
  category      String
  channel       MessageChannel
  enabled       Boolean
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([recipientType, recipientId, category, channel])
  @@index([recipientType, recipientId])
}

/// A managed message template (COMM-03, R-049).
///
/// NOT THE SAME THING as the typed templates in
/// packages/core/notifications/templates.ts, and the two do not overlap
/// (D-44). Those render the product's own automated messages and are checked
/// by the compiler; these are written by a property manager for the things a
/// person sends - violation notices, renewal offers, welcome packets - and
/// are strings with `{{merge_fields}}` that no compiler will ever see. The
/// closed catalogue in packages/core/comms/merge-fields.ts, validation on
/// save, and preview-before-send are what replace the type checking.
model MessageTemplate {
  id               String   @id @default(cuid())
  /// Free text, shown in the picker. Named by the person who will look for it.
  name             String
  /// ROUTINE or LEGAL. Decides whether an unapproved translation may be used
  /// (COMM-03) - see `languageFor`. Not an enum: notice types are
  /// jurisdiction configuration (D-4) and this is the same argument one level
  /// up, but the VALUES are a closed pair in core.
  kind             String
  /// Null for an SMS-only template. An email with no subject is a template
  /// that will be delivered looking like spam.
  subject          String?
  body             String
  /// Retired rather than deleted, like every other referenceable row here: a
  /// message sent from a template is evidence, and the template it was sent
  /// from is part of explaining it.
  active           Boolean  @default(true)
  createdByStaffId String
  updatedByStaffId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy    StaffUser                    @relation("TemplateCreatedBy", fields: [createdByStaffId], references: [id])
  /// Restrict, not the SetNull Prisma defaults to for an optional relation.
  /// Who last edited a template is part of explaining a message sent from it.
  updatedBy    StaffUser?                   @relation("TemplateUpdatedBy", fields: [updatedByStaffId], references: [id], onDelete: Restrict)
  translations MessageTemplateTranslation[]

  @@index([active, name])
}

/// One template in one language (COMM-03).
///
/// `approvedAt` IS THE WHOLE POINT OF THIS TABLE. COMM-03 permits machine
/// translation for routine chat and forbids it for legal notices, and once
/// both are rows the only thing telling them apart is whether somebody with
/// authority signed this one off. A LEGAL template with an unapproved
/// translation falls back to the default language and reports why, rather
/// than serving a notice whose words nobody read.
model MessageTemplateTranslation {
  id                String    @id @default(cuid())
  templateId        String
  /// BCP-47, matching `Tenant.preferredLocale`.
  locale            String
  subject           String?
  body              String
  /// Null until reviewed. For a LEGAL template this is an attorney sign-off;
  /// the product cannot verify that, so it records WHO and WHEN and makes the
  /// claim auditable rather than pretending to check it.
  approvedAt        DateTime?
  approvedByStaffId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Restrict. WHO approved a legal translation is the auditable claim this
  /// column exists to make; SetNull would erase it on a staff delete.
  approvedBy StaffUser?      @relation("TranslationApprovedBy", fields: [approvedByStaffId], references: [id], onDelete: Restrict)

  /// One translation per language per template. Two Spanish versions is a
  /// question nobody can answer at send time.
  @@unique([templateId, locale])
}

/// A legally significant notice and the proof it was served. `addressOfRecord`
/// is stored as rendered rather than joined at read time: what matters in a
/// dispute is the address the notice actually carried on the day it went out,
/// not the tenant's address today.
///
/// EXACTLY ONE of `leaseId` / `applicantId` (CHECK constraint, R-061) - a
/// notice is addressed to a tenancy or to an applicant who has none yet
/// (LEASE-05's FCRA adverse action), never both and never neither. Mirrors
/// the either/or shape MAINT-03 already gave `WorkOrder` assignment (D-9).
model Notice {
  id                 String               @id @default(cuid())
  propertyId         String
  leaseId            String?
  /// FCRA adverse action (R-061) - the other half of the either/or above.
  applicantId        String?
  /// Notice types are jurisdiction config (D-4), not an enum here - a state
  /// that invents a new notice must not require a migration.
  type               String
  addressOfRecord    String
  bodyText           String?
  /// The generated PDF (R-051). This is the artifact that was actually
  /// served - archived so that what the tenant received can be reproduced
  /// years later, rather than re-rendered from a template that has since
  /// changed.
  documentId         String?
  /// THE FIRST SERVICE, denormalized from `deliveries` (R-051).
  ///
  /// Service is frequently more than one event - several states require a
  /// notice be both posted and mailed - so the real record is the
  /// `NoticeDelivery` rows. These three columns are kept as the first of
  /// them so list screens can sort and filter without a join, and so every
  /// reader written before R-051 keeps working unchanged. Never write them
  /// without writing the matching delivery row; `recordService()` owns both.
  serviceMethod      NoticeServiceMethod?
  servedAt           DateTime?
  servedByStaffId    String?
  /// Superseded by `NoticeDelivery.proofDocumentId` / `.trackingNumber`
  /// (R-051), which carry one proof per service event rather than one per
  /// notice. Kept and still populated from the first service, because the
  /// backfill reads them and because dropping a column that holds evidence
  /// is not a tidy-up.
  proofDocumentId    String?
  trackingNumber     String?
  /// The rule version whose notice period produced this notice's deadlines.
  jurisdictionRuleId String?
  generatedAt        DateTime             @default(now())
  createdAt          DateTime             @default(now())

  property           Property          @relation(fields: [propertyId], references: [id])
  // Both explicit onDelete: Restrict, made EXPLICIT now that leaseId is
  // optional - a required relation defaults to Restrict, but an optional
  // one defaults to SetNull, and a notice silently losing its lease or
  // applicant link on delete is exactly the evidence loss this table
  // exists to prevent (leaseId's own original migration already set
  // RESTRICT; this keeps that true now that the column can be null).
  lease              Lease?            @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  applicant          Applicant?        @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  servedBy           StaffUser?        @relation("NoticeServedBy", fields: [servedByStaffId], references: [id])
  jurisdictionRule   JurisdictionRule? @relation(fields: [jurisdictionRuleId], references: [id])
  document           Document?         @relation("NoticeDocument", fields: [documentId], references: [id])
  proofDocument      Document?         @relation("NoticeProofDocument", fields: [proofDocumentId], references: [id])
  entryForWorkOrders WorkOrder[]       @relation("WorkOrderEntryNotice")
  deliveries         NoticeDelivery[]
  adverseActionFor   ScreeningReport?

  @@index([leaseId])
  @@index([applicantId])
  @@index([propertyId, servedAt])
}

/// One service event, with its own proof (R-051, COMM-02).
///
/// APPEND-ONLY BY TRIGGER, with exactly one exception: `readAt` may go from
/// null to a timestamp once, because the tenant opens a portal notice after
/// it was served and that opening is itself the proof service reached them.
/// Nothing else on a service record may ever move. See the migration.
///
/// Three CHECK constraints hold the shape the enum names promise:
/// POSTED_WITH_PHOTO requires a photograph, CERTIFIED_MAIL requires a
/// tracking number, and a read receipt only exists for PORTAL service.
model NoticeDelivery {
  id                      String              @id @default(cuid())
  noticeId                String
  method                  NoticeServiceMethod
  servedAt                DateTime
  servedByStaffId         String?
  /// The photograph of the posted notice, or the certified-mail receipt.
  /// `Document.capturedAt` carries the EXIF timestamp, which for a posted
  /// notice is the evidence - see R-012.
  proofDocumentId         String?
  trackingNumber          String?
  carrier                 String?
  /// PORTAL service only, and write-once: the proof is when the tenant
  /// FIRST read it, so a second view never overwrites the first.
  readAt                  DateTime?
  /// Whether the jurisdiction permits this method for this notice type.
  /// NULL means no rule is configured - deliberately not `false`, because
  /// "we do not know what this state allows" and "this state forbids it"
  /// are different facts and only one of them is an accusation (D-4).
  permittedByJurisdiction Boolean?
  jurisdictionRuleId      String?
  note                    String?
  createdAt               DateTime            @default(now())

  notice           Notice            @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  servedBy         StaffUser?        @relation("NoticeDeliveryServedBy", fields: [servedByStaffId], references: [id], onDelete: Restrict)
  proofDocument    Document?         @relation("NoticeDeliveryProof", fields: [proofDocumentId], references: [id], onDelete: Restrict)
  jurisdictionRule JurisdictionRule? @relation(fields: [jurisdictionRuleId], references: [id], onDelete: Restrict)

  @@index([noticeId])
  @@index([servedAt])
}

model Inspection {
  id                 String         @id @default(cuid())
  propertyId         String
  unitId             String
  leaseId            String?
  type               InspectionType
  scheduledFor       DateTime?
  performedAt        DateTime?
  performedByStaffId String?
  tenantSignedAt     DateTime?
  /// Once locked the report is immutable evidence (INSP-01). The move-out
  /// comparison is only worth anything if the move-in side cannot be edited
  /// after the damage is found.
  lockedAt           DateTime?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  property    Property         @relation(fields: [propertyId], references: [id])
  unit        Unit             @relation(fields: [unitId], references: [id])
  lease       Lease?           @relation(fields: [leaseId], references: [id])
  performedBy StaffUser?       @relation("InspectionPerformedBy", fields: [performedByStaffId], references: [id])
  items       InspectionItem[]

  @@index([propertyId, type])
  @@index([unitId])
  @@index([leaseId])
}

/// `moveInItemId` links a move-out item to its move-in counterpart. That pair
/// - the photo then next to the photo now - is the deposit-disposition
/// evidence (INSP-02), so it is a real foreign key, not a convention.
model InspectionItem {
  id           String        @id @default(cuid())
  inspectionId String
  room         String
  item         String
  condition    ItemCondition
  notes        String?
  moveInItemId String?       @unique
  createdAt    DateTime      @default(now())

  inspection  Inspection      @relation(fields: [inspectionId], references: [id])
  moveInItem  InspectionItem? @relation("MoveInToMoveOut", fields: [moveInItemId], references: [id])
  moveOutItem InspectionItem? @relation("MoveInToMoveOut")

  @@index([inspectionId])
}

/// Attaches to whatever it is evidence of. The nullable foreign keys below
/// are the entities with real query paths ("every photo on this work order",
/// "this lease's file"); anything rarer gets a row on the entity that needs
/// it rather than a fifteenth column here.
///
/// `capturedAt` is the EXIF timestamp and must never be stripped: a photo's
/// timestamp IS the evidence.
model Document {
  id                String    @id @default(cuid())
  propertyId        String?
  unitId            String?
  leaseId           String?
  tenantId          String?
  vendorId          String?
  ticketId          String?
  workOrderId       String?
  /// R-059: an ID scan or income document attached to one household
  /// member's application, not to the household or the listing - screening
  /// (R-060) reads a specific person's documents, never "the household's".
  applicantId       String?
  /// Document class - lease, notice, invoice, w9, coi, inspection_photo, etc.
  /// Drives the retention rules R-012 configures (DOC-05).
  type              String
  fileName          String
  contentType       String
  sizeBytes         Int
  /// Object-store key. Files never live in Postgres.
  storageKey        String
  sha256            String?
  version           Int       @default(1)
  /// Original capture time from EXIF, preserved. Distinct from createdAt,
  /// which is only when it was uploaded.
  capturedAt        DateTime?
  uploadedByStaffId String?
  /// Soft-delete marker (DOC-05's 30-day undelete). Null means active. Who
  /// deleted it and why lives in AuditLog ('document.delete_marked'), not
  /// here - the same split Property.active relies on for the same reason.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  property             Property?        @relation(fields: [propertyId], references: [id])
  unit                 Unit?            @relation(fields: [unitId], references: [id])
  lease                Lease?           @relation(fields: [leaseId], references: [id])
  tenant               Tenant?          @relation(fields: [tenantId], references: [id])
  vendor               Vendor?          @relation(fields: [vendorId], references: [id])
  ticket               Ticket?          @relation(fields: [ticketId], references: [id])
  workOrder            WorkOrder?       @relation(fields: [workOrderId], references: [id])
  applicant            Applicant?       @relation(fields: [applicantId], references: [id])
  uploadedBy           StaffUser?       @relation("DocumentUploadedBy", fields: [uploadedByStaffId], references: [id])
  noticesAsDocument    Notice[]         @relation("NoticeDocument")
  noticesAsProof       Notice[]         @relation("NoticeProofDocument")
  noticeDeliveryProofs NoticeDelivery[] @relation("NoticeDeliveryProof")
  utilityBills         UtilityBill[]    @relation("UtilityBillDocument")

  @@index([propertyId, type])
  @@index([unitId])
  @@index([leaseId])
  @@index([workOrderId])
  @@index([applicantId])
}

// ---------------------------------------------------------------------------
// Operations & configuration
// ---------------------------------------------------------------------------

/// THE work queue (D-9). Delinquency steps, failed payments, move-out
/// verification, inspection follow-ups, compliance items, bounced messages
/// and vendor no-shows are all VIEWS over this table. Do not add a second
/// queue table - the storage build had to consolidate seven of them after the
/// fact, which is why this one exists before its first consumer.
model Task {
  id                 String     @id @default(cuid())
  propertyId         String
  /// Free-form so a later item can add a task type without a migration.
  type               String
  /// What the task is about: "Lease", "WorkOrder", "Deposit", plus its id.
  subjectType        String
  subjectId          String
  /// The property-local calendar day this task belongs to (D-3). Part of the
  /// idempotency key, so a nightly job that runs twice creates one task.
  businessDate       DateTime   @db.Date
  priority           Priority   @default(ROUTINE)
  /// Null means anyone on the team can pick it up.
  assigneeStaffId    String?
  status             TaskStatus @default(OPEN)
  title              String
  /// Typed completion proof - the photo, the reading, the confirmation the
  /// task type demands. Shape is per task type and belongs to R-011.
  proof              Json?
  completedByStaffId String?
  completedAt        DateTime?
  /// The domain event that created this task, for tracing back through the
  /// outbox (R-006).
  sourceEventId      String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  property    Property   @relation(fields: [propertyId], references: [id])
  assignee    StaffUser? @relation("TaskAssignedTo", fields: [assigneeStaffId], references: [id])
  completedBy StaffUser? @relation("TaskCompletedBy", fields: [completedByStaffId], references: [id])

  /// Idempotent creation (D-9). All three columns are NOT NULL so Postgres
  /// actually enforces this - a nullable column in a unique index would let
  /// duplicates through, because NULLs never equal each other.
  @@unique([type, subjectId, businessDate])
  @@index([propertyId, status, businessDate])
  @@index([assigneeStaffId, status])
}

/// Every statutory number in the product, versioned and effective-dated
/// (D-4). Nothing anywhere reads a grace period, a fee cap, a deposit
/// deadline or a notice period any other way. Rules apply prospectively -
/// changing a rule never rewrites history, which is why Charge, Notice and
/// Deposit store the rule id that produced their numbers.
///
/// Texas is seeded at R-010, not here. R-002 owns the table; R-010 owns the
/// resolver `rulesFor(property, asOf)` and the reviewed content.
model JurisdictionRule {
  id            String    @id @default(cuid())
  /// Two-letter state code.
  state         String
  /// City or county for a local ordinance that overrides the state rule.
  /// Null means statewide.
  jurisdiction  String?
  version       Int
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  // Late fees (PAY-04). Percentages are basis points: 5% is 500.
  graceDays            Int
  lateFeeType          LateFeeType @default(NONE)
  lateFeeFlatCents     Int?
  lateFeePercentBps    Int?
  lateFeeDailyCents    Int?
  /// The statutory ceiling core clamps to (D-12). Either or both may apply.
  lateFeeMaxCents      Int?
  lateFeeMaxPercentBps Int?

  // Deposits (PAY-07, INSP-03).
  depositMaxBps           Int?
  depositDispositionDays  Int?
  depositEscrowRequired   Boolean @default(false)
  depositInterestRequired Boolean @default(false)

  // Entry and notices (MAINT-05, PAY-14, LEASE-09).
  entryNoticeHours       Int?
  payOrQuitDays          Int?
  noticeToVacateDays     Int?
  rentIncreaseNoticeDays Int?
  justCauseRequired      Boolean @default(false)
  /// RISK-06 (R-055, D-4). How long after a tenant complaint a rent
  /// increase, non-renewal or notice carries a rebuttable presumption of
  /// retaliation - commonly ~180 days (six months), never a constant in
  /// code. Null means not configured, not "no window applies" - see
  /// packages/core/leases/retaliation.ts for how a null window is read.
  retaliationWindowDays  Int?
  /// WHICH SERVICE METHODS THE STATE ALLOWS, PER NOTICE TYPE (R-051, COMM-02).
  ///
  /// `NoticeServiceMethod` lists the mechanics this product can record proof
  /// for; it has never said any of them is lawful where you are, and that is
  /// a jurisdiction fact like every other number here (D-4). Several states
  /// require a notice to vacate be both posted AND mailed, and several forbid
  /// email service outright.
  ///
  /// JSON rather than columns because notice TYPES are themselves free-form
  /// configuration - see `Notice.type` - so a state that invents a new notice
  /// must not require a migration, and neither must one that changes which
  /// methods serve it. Shape: `{ "NOTICE_TO_VACATE": ["PERSONAL", "CERTIFIED_MAIL"] }`,
  /// validated by `validateJurisdictionRule` on write.
  ///
  /// Null, or a type absent from the map, means NO RULE IS CONFIGURED - never
  /// "no method is permitted". Service is still recordable and is flagged as
  /// unverified, the same call R-044's `graceUnknown` makes.
  noticeServiceMethods   Json?

  // Payments and applications (PAY-03, LEASE-03).
  /// Ordered ChargeType names - "rent before fees" where the state says so.
  paymentAllocationOrder  String[]
  /// PAY-01's card pass-through, as configuration rather than a literal
  /// (D-4). Several states restrict surcharging outright and some regulate
  /// rent convenience fees specifically, so whether the tenant may be
  /// charged the processing cost is a jurisdiction fact. Where it is not
  /// permitted the owner absorbs it and the tenant sees no fee at all.
  /// PAY-02's returned-payment fee, as configuration rather than a literal
  /// (D-4). Texas caps a returned-check fee at 30 USD (Tex. Bus. & Com. Code
  /// §3.506); other states differ and several bar one entirely. Core
  /// computes and clamps it (D-12).
  nsfFeePermitted         Boolean  @default(true)
  nsfFeeMaxCents          Int?
  cardSurchargePermitted  Boolean  @default(true)
  /// A statutory ceiling on the surcharge, in basis points of the amount
  /// being paid. Null where the state sets none. Core clamps to it (D-12).
  cardSurchargeMaxBps     Int?
  applicationFeeCapCents  Int?
  rubsPermitted           Boolean  @default(true)
  /// LEASE-01 (R-056, D-4). Whether this jurisdiction makes source of income
  /// (housing vouchers, Section 8) a protected class - required disclosure
  /// on a listing where it applies. A THIRD state, not a boolean: null means
  /// unreviewed, exactly like `retaliationWindowDays`'s own null - a listing
  /// disclosure must never assert protection that was never actually
  /// checked, and must never assert its absence either.
  sourceOfIncomeProtected Boolean?

  /// Statute citation and who reviewed it. Every one of these numbers needs
  /// an attorney's eyes before it governs a real tenancy; this is where that
  /// review is recorded.
  citation   String?
  reviewedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  charges          Charge[]
  notices          Notice[]
  noticeDeliveries NoticeDelivery[]

  @@unique([state, jurisdiction, version])
  @@index([state, effectiveFrom])
}

/// Unmodifiable by any role (ROLE-03), enforced by trigger. Actor is nullable
/// for SYSTEM actions; `actorType` says which kind of actor it was, because a
/// tenant, a vendor on a magic link and a nightly job are all legitimate
/// authors of an audit row and none of them is a StaffUser.
model AuditLog {
  id           String    @id @default(cuid())
  propertyId   String?
  actorType    ActorType
  actorStaffId String?
  /// Non-staff actor identity - tenant id, vendor id, or job name.
  actorRef     String?
  entityType   String
  entityId     String
  action       String
  before       Json?
  after        Json?
  /// Why, where the action demands a reason: a fee waiver, an entry-notice
  /// override, a deviation from order-of-completed-application.
  reasonCode   String?
  reason       String?
  ipAddress    String?
  userAgent    String?
  occurredAt   DateTime  @default(now())

  property   Property?  @relation(fields: [propertyId], references: [id])
  actorStaff StaffUser? @relation("AuditLogActor", fields: [actorStaffId], references: [id])

  @@index([entityType, entityId])
  @@index([propertyId, occurredAt])
  @@index([actorStaffId, occurredAt])
}

/// A carrier-level SMS opt-out (R-040e, D-38).
///
/// KEYED BY PHONE NUMBER, NOT BY TENANT. A STOP blocks a number against our
/// sending number: it survives the tenant moving out, it applies to whoever
/// holds the number next, and nothing in `NotificationPreference` can
/// override it. That is why it is a separate table - preferences are a
/// tenant's choice about a category, this is a carrier's fact about a number.
///
/// It outranks `LOCKED_CATEGORIES`. The product refuses to let a tenant turn
/// off `entry_notice` because that notice is legally significant; a carrier
/// STOP turns it off anyway. Recording that here is what stops the
/// notification log claiming we served a notice we did not deliver.
/// That a tenant AGREED to be contacted, and on what basis (R-051b, COMM-02).
///
/// The counterpart of `SmsOptOut`, and deliberately a different key.
/// `SmsOptOut` is a fact about a PHONE NUMBER, reported by a carrier; this is
/// a fact about a PERSON and the permission they gave. A number reassigned to
/// somebody else must not carry the old tenant's consent, and a tenant who
/// changes number must not lose it - which one table keyed on either alone
/// cannot express.
///
/// APPEND-ONLY BY TRIGGER except for withdrawal (`revokedAt` null -> a
/// timestamp, once, with an optional reason). Re-consenting after a
/// withdrawal is a new row, so the history of a permission given, taken back
/// and given again survives intact.
model TenantConsent {
  id                String         @id @default(cuid())
  tenantId          String
  channel           ConsentChannel
  basis             ConsentBasis
  source            ConsentSource
  /// The words the tenant was actually shown. Required for EXPRESS_WRITTEN by
  /// a CHECK constraint - the basis that unlocks promotional sending is the
  /// one that has to be able to show what was consented to.
  disclosureText    String?
  recordedAt        DateTime       @default(now())
  recordedByStaffId String?
  note              String?
  revokedAt         DateTime?
  revokeReason      String?
  createdAt         DateTime       @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recordedBy StaffUser? @relation("TenantConsentRecordedBy", fields: [recordedByStaffId], references: [id], onDelete: Restrict)

  @@index([tenantId, channel])
}

model SmsOptOut {
  id         String          @id @default(cuid())
  /// E.164.
  phone      String          @unique
  optedOutAt DateTime        @default(now())
  source     SmsOptOutSource
  /// The keyword they sent, or the provider error code that told us.
  reason     String?
  /// Set when START arrives. The row is kept rather than deleted - a number
  /// that has opted out and back in twice is a pattern worth seeing.
  revokedAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  // NO @@index HERE. `phone` is already `@unique`, which is the index every
  // query on this table uses, and there is one row per number. An earlier
  // version declared a second index and created it in SQL as a PARTIAL one
  // (`WHERE revokedAt IS NULL`) - a shape Prisma cannot express, so the drift
  // check reported a missing index on every CI run for ever (R-040e).
}

enum SmsOptOutSource {
  /// The tenant texted STOP (or a synonym) and we saw it.
  INBOUND_KEYWORD
  /// The provider told us a send was blocked - Twilio error 21610 and its
  /// relatives. This is the one that catches an opt-out sent to a carrier
  /// that never forwarded the keyword to us, which is the common case.
  CARRIER_CALLBACK
}

enum DepositArrangement {
  /// Cash held on trust. The liability case.
  CASH
  /// A surety bond or deposit-replacement product: the tenant pays a premium
  /// to a third party and the landlord holds nothing.
  SURETY_BOND
  /// No deposit of any kind.
  NONE
}

enum ProrationMethod {
  /// Divide by the days the month actually has. What a tenant checking
  /// against a calendar expects, and the default.
  ACTUAL
  /// Divide by a flat 30, whatever the month. A convention that has to be
  /// chosen deliberately.
  BANKER30
}
