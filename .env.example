# Copy to .env.local (gitignored) and fill in. Names only here - never values.
# Root .env.local is the single source of truth; npm scripts inject it via dotenv-cli.
# Mirror these into Vercel project settings before the first deploy.

# --- Database (Neon Postgres) - R-001/R-002 ---
# Pooled connection used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL=

# --- Auth.js - R-003 ---
# Signing key for session JWTs. Generate with: openssl rand -base64 32
#
# It also derives (via HKDF) the key that encrypts stored MFA secrets. That is
# deliberate: anyone holding AUTH_SECRET can forge a session for any user and
# never has to defeat MFA, so a second key would buy nothing against them -
# while deriving from a value that is NOT in the database still protects TOTP
# seeds against a database dump.
#
# Consequence: ROTATING AUTH_SECRET FORCES EVERY STAFF USER TO RE-ENROL IN MFA.
# Recovery codes go with it. That is the right behaviour after a leak, but it
# is not a free operation - plan it.
AUTH_SECRET=
# Origin used to build tenant magic-link, vendor work-order link, and reset
# URLs, and the origin Auth.js redirects to after sign-in. Never derived from
# the request Host header, which an attacker can set.
AUTH_URL=

# --- Background jobs - R-006 ---
# Shared secret for the /api/cron endpoint. Vercel Cron sends it as a Bearer
# token; the route must reject every request when this is unset.
# Note D-3: the cron fires hourly and the runner decides which properties are
# due in their own local timezone. Never schedule business logic at UTC midnight.
CRON_SECRET=

# --- Added in later backlog items; listed so nothing is a surprise ---

# Stripe Billing, test mode only (R-034). D-11: Stripe is the system of record
# for invoices and payments; our LedgerEntry table is a projection of it.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Resend email (R-030)
# RESEND_API_KEY=

# Twilio SMS (R-030). 10DLC registration has a real lead time - start it early.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
