# Copy to .env.local (gitignored) and fill in. Names only here - never values.
# Root .env.local is the single source of truth; npm scripts inject it via dotenv-cli.
# Mirror these into Vercel project settings before the first deploy.

# --- Database (Neon Postgres) - R-001/R-002 ---
# Pooled connection used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection used by Prisma Migrate.
DIRECT_URL=

# --- Auth.js - R-003 ---
# Signing key for session JWTs. Generate with: openssl rand -base64 32
#
# It also derives (via HKDF) the key that encrypts stored MFA secrets. That is
# deliberate: anyone holding AUTH_SECRET can forge a session for any user and
# never has to defeat MFA, so a second key would buy nothing against them -
# while deriving from a value that is NOT in the database still protects TOTP
# seeds against a database dump.
#
# Consequence: ROTATING AUTH_SECRET FORCES EVERY STAFF USER TO RE-ENROL IN MFA.
# Recovery codes go with it. That is the right behaviour after a leak, but it
# is not a free operation - plan it.
AUTH_SECRET=
# Origin used to build tenant magic-link, vendor work-order link, and reset
# URLs, and the origin Auth.js redirects to after sign-in. Never derived from
# the request Host header, which an attacker can set.
AUTH_URL=

# --- Background jobs - R-006 ---
# Shared secret for the /api/cron endpoint. Vercel Cron sends it as a Bearer
# token; the route must reject every request when this is unset.
# Note D-3: the cron fires hourly and the runner decides which properties are
# due in their own local timezone. Never schedule business logic at UTC midnight.
CRON_SECRET=

# --- Notification engine - R-016 ---
# The kill switch. Anything other than the exact string "false" leaves sending
# ENABLED, including leaving this unset - a missing variable must not become a
# silent, portfolio-wide notification outage on a deploy that forgot it.
# Set to "false" to stop all sending immediately without a deploy; notifications
# are still decided and recorded as suppressed, so afterwards there is a
# complete list of exactly what would have gone out.
# NOTIFICATIONS_ENABLED=true
#
# Sandbox redirect. When set, EVERY notification goes to this address instead
# of the real recipient, with the intended address preserved on the record.
# SET THIS IN EVERY NON-PRODUCTION ENVIRONMENT. It is what stops a laptop
# pointed at a copy of production data from texting real tenants.
# NOTIFICATIONS_SANDBOX_TO=dev@example.com

# --- Added in later backlog items; listed so nothing is a surprise ---

# Stripe Billing, test mode only (R-034). D-11: Stripe is the system of record
# for invoices and payments; our LedgerEntry table is a projection of it.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Resend email. The R-016 engine ships with a logging adapter; wiring a real
# Resend driver needs this key AND a verified sending domain with SPF/DKIM,
# which is an external workstream with its own lead time (D-15).
# RESEND_API_KEY=
# RESEND_FROM=notifications@yourdomain.com

# Twilio SMS. Needs an APPROVED 10DLC brand and campaign before a single
# message can be SENT to a US mobile number - registration takes days to weeks
# and is the longest lead time in this file. Start it before you need it (D-15).
# TWILIO_ACCOUNT_SID=
# TWILIO_MESSAGING_SERVICE_SID=
#
# TWILIO_AUTH_TOKEN is needed sooner than the rest, and for a different
# reason: it verifies the SIGNATURE on Twilio's INBOUND webhook (R-021), which
# is the only authentication that public endpoint has. Inbound does not depend
# on 10DLC - a Twilio number can receive before the campaign clears - so this
# is the one Twilio value worth setting as soon as a number exists.
#
# Point the number's "A MESSAGE COMES IN" webhook at:
#   POST {AUTH_URL}/api/sms/inbound
# The route refuses every request while this is unset (503, so Twilio retries
# once it is configured rather than dropping the message).
# TWILIO_AUTH_TOKEN=
